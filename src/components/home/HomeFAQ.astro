---
import FAQItem from '../FAQItem.astro';
import SectionIntro from '../SectionIntro.astro';
import Reveal from '../Reveal.astro';
import PawTrail from '../PawTrail.astro';
import copy from '../../data/copy/home.json';
const c = copy.faq;
export interface Props {
  faqs: { q: string; a: string }[];
}
const { faqs } = Astro.props;
---
<section class="section relative isolate">
  <PawTrail variant="right" />
  <div class="container-tight">
    <Reveal class="mb-10">
      <SectionIntro eyebrow={c.eyebrow} heading={c.heading} />
    </Reveal>

    <div class="space-y-3">
      {faqs.map((f, i) => (
        <Reveal delay={i * 60}>
          <FAQItem faq={f} open={i === 0} />
        </Reveal>
      ))}
    </div>

    <Reveal delay={200}>
      <p class="mt-8 text-sm text-ink-600">
        More on the <a href="/faq/" class="text-teal-700 font-semibold hover:text-coral-700">full FAQ page</a>.
      </p>
    </Reveal>
  </div>
</section>
