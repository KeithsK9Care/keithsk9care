---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';
import { services } from '../lib/content';
import copy from '../data/copy/book.json';
import SectionIntro from '../components/SectionIntro.astro';
import PageHero from '../components/PageHero.astro';
import Reveal from '../components/Reveal.astro';
import Section from '../components/Section.astro';

const m = copy.meta;
const h = copy.hero;
const qc = copy.quickContact;
const f = copy.form;
const loc = copy.location;

const waMsg = encodeURIComponent(qc.whatsapp.prefilledMessage || "Hi Keith, I'd like to book a groom for my dog.");
---
<Layout title={m.title} description={m.description} noindex={true} hideWhatsApp={true} ogImage={m.ogImage}>

  <PageHero eyebrow={h.eyebrow} heading={h.heading} body={h.body} align="left" photo={h.photo} photoAlt={h.photoAlt} />

  <!-- QUICK CONTACT ROW -->
  <section class="pb-4">
    <div class="container-tight grid sm:grid-cols-3 gap-3">
      <Reveal>
        <a href={`tel:${site.phoneIntl}`} class="block rounded-2xl bg-white ring-1 ring-ink-100 p-5 hover:ring-coral-300 hover:shadow-md transition">
          <p class="text-xs font-semibold uppercase tracking-wider text-coral-700">{qc.call.label}</p>
          <p class="mt-1 text-lg font-display font-semibold text-teal-700">{site.phone}</p>
          <p class="mt-0.5 text-xs text-ink-600">{qc.call.title}</p>
        </a>
      </Reveal>
      <Reveal delay={80}>
        <a href={`https://wa.me/${site.whatsappIntl}?text=${waMsg}`} target="_blank" rel="noopener" class="block rounded-2xl bg-whatsapp text-white p-5 hover:bg-green-600 transition">
          <p class="text-xs font-semibold uppercase tracking-wider text-white/80">{qc.whatsapp.label}</p>
          <p class="mt-1 text-lg font-display font-semibold">{qc.whatsapp.title}</p>
          <p class="mt-0.5 text-xs text-white/90">{qc.whatsapp.subtitle}</p>
        </a>
      </Reveal>
      <Reveal delay={160}>
        <a href={`mailto:${site.email}`} class="block rounded-2xl bg-white ring-1 ring-ink-100 p-5 hover:ring-coral-300 hover:shadow-md transition">
          <p class="text-xs font-semibold uppercase tracking-wider text-coral-700">{qc.email.label}</p>
          <p class="mt-1 text-base font-display font-semibold text-teal-700 break-all">{site.email}</p>
          <p class="mt-0.5 text-xs text-ink-600">{qc.email.subtitle}</p>
        </a>
      </Reveal>
    </div>
  </section>

  <!-- FORM -->
  <section class="section relative overflow-hidden bg-gradient-to-br from-teal-50/70 via-white to-coral-50/60">
    <!-- decorative blurred blobs -->
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute -top-24 -right-16 w-96 h-96 bg-coral-100 rounded-full blur-3xl opacity-40"></div>
      <div class="absolute -bottom-24 -left-16 w-96 h-96 bg-teal-100 rounded-full blur-3xl opacity-40"></div>
    </div>

    <div class="container-tight relative">
      <Reveal class="mb-8">
        <SectionIntro
          eyebrow={f.eyebrow}
          heading={f.heading}
          description={f.description}
        />
      </Reveal>

      <div id="kk9-form-status" role="alert" class="hidden mb-6 rounded-xl border border-coral-200 bg-coral-50 px-5 py-4 text-sm font-semibold text-coral-800"></div>

      <Reveal delay={100}>
        <form
          id="kk9-book-form"
          method="POST"
          action={site.bookingFormEndpoint}
          class="rounded-3xl bg-white/95 ring-1 ring-ink-100 shadow-xl shadow-teal-900/5 p-6 md:p-8 space-y-5"
        >
          <input type="hidden" name="_subject" value="New booking enquiry, Keith's K9 Care" />
          <!-- Honeypot (Formspree's _gotcha), hidden from real users, bots tend to fill -->
          <div class="hidden" aria-hidden="true">
            <label>Company (leave blank): <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
          </div>

          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label for="name" class="block text-sm font-semibold text-ink-800">Your name <span class="text-coral-700">*</span></label>
              <div class="relative mt-1.5">
                <svg aria-hidden="true" class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 w-5 h-5 text-ink-300" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M7.5 6a4.5 4.5 0 119 0 4.5 4.5 0 01-9 0zM3.751 20.105a8.25 8.25 0 0116.498 0 .75.75 0 01-.437.695A18.683 18.683 0 0112 22.5c-2.786 0-5.433-.608-7.812-1.7a.75.75 0 01-.437-.695z" clip-rule="evenodd"/></svg>
                <input id="name" name="name" type="text" required aria-required="true" class="form-input form-input-icon" placeholder="Jane Smith" autocomplete="name" />
              </div>
            </div>
            <div>
              <label for="phone" class="block text-sm font-semibold text-ink-800">Phone</label>
              <div class="relative mt-1.5">
                <svg aria-hidden="true" class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 w-5 h-5 text-ink-300" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M1.5 4.5a3 3 0 013-3h1.372c.86 0 1.61.586 1.819 1.42l1.105 4.423a1.875 1.875 0 01-.694 1.955l-1.293.97c-.135.101-.164.249-.126.352a11.285 11.285 0 006.697 6.697c.103.038.25.009.352-.126l.97-1.293a1.875 1.875 0 011.955-.694l4.423 1.105c.834.209 1.42.959 1.42 1.82V19.5a3 3 0 01-3 3h-2.25C8.552 22.5 1.5 15.448 1.5 6.75V4.5z" clip-rule="evenodd"/></svg>
                <input id="phone" name="phone" type="tel" class="form-input form-input-icon" placeholder="07…" autocomplete="tel" />
              </div>
            </div>
          </div>

          <div>
            <label for="email" class="block text-sm font-semibold text-ink-800">Email <span class="text-coral-700">*</span></label>
            <div class="relative mt-1.5">
              <svg aria-hidden="true" class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 w-5 h-5 text-ink-300" fill="currentColor" viewBox="0 0 24 24"><path d="M1.5 8.67v8.58a3 3 0 003 3h15a3 3 0 003-3V8.67l-8.928 5.493a3 3 0 01-3.144 0L1.5 8.67z"/><path d="M22.5 6.908V6.75a3 3 0 00-3-3h-15a3 3 0 00-3 3v.158l9.714 5.978a1.5 1.5 0 001.572 0L22.5 6.908z"/></svg>
              <input id="email" name="email" type="email" required aria-required="true" class="form-input form-input-icon" placeholder="you@example.com" autocomplete="email" />
            </div>
          </div>

          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label for="dogName" class="block text-sm font-semibold text-ink-800">Your dog's name</label>
              <div class="relative mt-1.5">
                <svg aria-hidden="true" class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 w-5 h-5 text-ink-300" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M11.645 20.91l-.007-.003-.022-.012a15.247 15.247 0 01-.383-.218 25.18 25.18 0 01-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.25 2.25 5.322 4.714 3 7.688 3A5.5 5.5 0 0112 5.052 5.5 5.5 0 0116.313 3c2.973 0 5.437 2.322 5.437 5.25 0 3.925-2.438 7.11-4.739 9.256a25.175 25.175 0 01-4.244 3.17 15.247 15.247 0 01-.383.219l-.022.012-.007.004-.003.001a.752.752 0 01-.704 0l-.003-.001z" clip-rule="evenodd"/></svg>
                <input id="dogName" name="dogName" type="text" class="form-input form-input-icon" placeholder="Ringo" />
              </div>
            </div>
            <div>
              <label for="breed" class="block text-sm font-semibold text-ink-800">Breed / coat type</label>
              <div class="relative mt-1.5">
                <svg aria-hidden="true" class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 w-5 h-5 text-ink-300" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M5.25 2.25a3 3 0 00-3 3v4.318a3 3 0 00.879 2.121l9.58 9.581c.92.92 2.39 1.186 3.548.428a18.849 18.849 0 005.441-5.44c.758-1.16.492-2.629-.428-3.548l-9.58-9.581a3 3 0 00-2.122-.879H5.25zM6.375 7.5a1.125 1.125 0 100-2.25 1.125 1.125 0 000 2.25z" clip-rule="evenodd"/></svg>
                <input id="breed" name="breed" type="text" class="form-input form-input-icon" placeholder="Cockapoo, mini schnauzer…" />
              </div>
            </div>
          </div>

          <div>
            <label for="service" class="block text-sm font-semibold text-ink-800">Service you're interested in</label>
            <div class="relative mt-1.5">
              <svg aria-hidden="true" class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 w-5 h-5 text-ink-300" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M2.625 6.75a1.125 1.125 0 112.25 0 1.125 1.125 0 01-2.25 0zm4.875 0A.75.75 0 018.25 6h12a.75.75 0 010 1.5h-12a.75.75 0 01-.75-.75zM2.625 12a1.125 1.125 0 112.25 0 1.125 1.125 0 01-2.25 0zM7.5 12a.75.75 0 01.75-.75h12a.75.75 0 010 1.5h-12A.75.75 0 017.5 12zm-4.875 5.25a1.125 1.125 0 112.25 0 1.125 1.125 0 01-2.25 0zm4.875 0a.75.75 0 01.75-.75h12a.75.75 0 010 1.5h-12a.75.75 0 01-.75-.75z" clip-rule="evenodd"/></svg>
              <select id="service" name="service" class="form-input form-input-icon">
                <option value="">Not sure, Keith to advise</option>
                {services.map((s) => <option value={s.name}>{s.name}</option>)}
              </select>
            </div>
          </div>

          <div>
            <label for="message" class="block text-sm font-semibold text-ink-800">Message <span class="text-coral-700">*</span></label>
            <textarea id="message" name="message" rows="5" required aria-required="true" class="form-input mt-1.5" placeholder="A little about your dog, age, last groom, anything Keith should know about behaviour or coat."></textarea>
          </div>

          <div class="!mt-2 -mx-6 md:-mx-8 !-mb-6 md:!-mb-8 px-6 md:px-8 py-5 rounded-b-3xl bg-teal-50/60 border-t border-ink-100 flex flex-col sm:flex-row sm:items-center justify-between gap-x-6 gap-y-3">
            <div class="text-xs leading-relaxed">
              <p class="flex items-start gap-1.5 font-semibold text-teal-700">
                <svg aria-hidden="true" class="w-4 h-4 mt-px shrink-0 text-coral-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd"/></svg>
                {f.reassurance}
              </p>
              <p class="text-ink-500 mt-1">{f.privacyNote} See our <a href="/privacy/" class="text-teal-700 font-semibold hover:text-coral-700 underline-offset-2 hover:underline">Privacy policy</a>.</p>
            </div>
            <button id="kk9-book-submit" type="submit" class="btn-primary justify-center group shrink-0">
              <span data-label class="inline-flex items-center gap-2">
                {f.submitLabel}
                <svg aria-hidden="true" class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
              </span>
              <span data-loading class="hidden inline-flex items-center gap-2">
                <svg aria-hidden="true" class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-30" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3"></circle>
                  <path class="opacity-80" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                {f.submitLoadingLabel}
              </span>
            </button>
          </div>
        </form>
      </Reveal>
    </div>
  </section>

  <!-- LOCATION -->
  <Section bg="ink">
    <div class="container-tight">
      <Reveal>
        <SectionIntro eyebrow={loc.eyebrow} heading={loc.heading} />
      </Reveal>
      <Reveal class="mt-8 grid md:grid-cols-2 gap-5" delay={100}>
        <div class="rounded-2xl bg-white ring-1 ring-ink-100 p-6">
          <p class="text-xs font-semibold uppercase tracking-wider text-coral-700 mb-3">{loc.addressLabel}</p>
          <address class="not-italic text-ink-800 text-lg leading-relaxed">
            {site.address.street}<br/>
            {site.address.locality}, {site.address.region}<br/>
            {site.address.postcode}
          </address>
          <a href={`https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(site.address.street + ', ' + site.address.postcode)}`} target="_blank" rel="noopener" class="btn-ghost mt-4">
            {loc.directionsLabel}
            <svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
          <p class="mt-4 text-sm text-ink-600">{loc.addressNote}</p>
        </div>

        <div class="rounded-2xl bg-white ring-1 ring-ink-100 p-6">
          <p class="text-xs font-semibold uppercase tracking-wider text-coral-700 mb-3">{loc.hoursLabel}</p>
          <ul class="text-ink-800 space-y-1">
            {site.hours.map(h => (
              <li class="flex justify-between gap-4"><span class="font-semibold">{h.day}</span><span>{h.open}–{h.close}</span></li>
            ))}
          </ul>
          <p class="text-sm text-ink-600 mt-3">{site.hoursNote}</p>
        </div>
      </Reveal>
    </div>
  </Section>
</Layout>

<script is:inline>
  (function () {
    var ERR = 'Sorry, something went wrong sending your message. Please call or WhatsApp Keith using the buttons above, or try again.';
    function arm() {
      var form = document.getElementById('kk9-book-form');
      var btn  = document.getElementById('kk9-book-submit');
      if (!form || !btn) return;
      if (form.dataset.armed === '1') return;
      form.dataset.armed = '1';

      var labelEl   = btn.querySelector('[data-label]');
      var loadingEl = btn.querySelector('[data-loading]');
      var statusEl  = document.getElementById('kk9-form-status');

      function busy(on) {
        btn.disabled = on;
        if (on) btn.setAttribute('aria-busy', 'true'); else btn.removeAttribute('aria-busy');
        if (labelEl)   labelEl.classList.toggle('hidden', on);
        if (loadingEl) loadingEl.classList.toggle('hidden', !on);
        form.classList.toggle('opacity-90', on);
        form.classList.toggle('pointer-events-none', on);
      }
      function fail(msg) {
        if (statusEl) {
          statusEl.textContent = msg || ERR;
          statusEl.classList.remove('hidden');
          statusEl.scrollIntoView({ block: 'center', behavior: 'smooth' });
        }
        busy(false);
      }

      // AJAX submit to Formspree, keeps the user on-site, shows a clean
      // loading state, redirects to /thanks/ on success, inline error on failure.
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        if (statusEl) statusEl.classList.add('hidden');
        busy(true);
        fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { 'Accept': 'application/json' }
        }).then(function (res) {
          if (res.ok) { window.location.assign('/thanks/'); return; }
          return res.json().catch(function () { return null; }).then(function (data) {
            var msg = (data && data.errors && data.errors.length)
              ? data.errors.map(function (x) { return x.message; }).join(' ')
              : ERR;
            fail(msg);
          });
        }).catch(function () { fail(ERR); });
      });
    }
    arm();
    document.addEventListener('astro:page-load', arm);
  })();
</script>

<style>
  .form-input {
    @apply block w-full rounded-xl border-0 ring-1 ring-ink-200 px-4 py-3 text-ink-900 placeholder:text-ink-400 focus:outline-none focus:ring-2 focus:ring-coral-400 focus:ring-offset-1 hover:ring-ink-300 transition;
    background: white;
  }
  .form-input-icon { padding-left: 2.75rem; }
  textarea.form-input { @apply leading-relaxed; }
  select.form-input { appearance: none; background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='12' height='8' viewBox='0 0 12 8'><path fill='%2308667a' d='M6 8L0 0h12z'/></svg>"); background-repeat: no-repeat; background-position: right 1rem center; padding-right: 2.5rem; }
</style>
