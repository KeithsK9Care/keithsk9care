---
/**
 * DetailHero, the split (text + tall image) hero shared by the service-detail
 * and groom-story-detail pages. The middle block (price/meta line) and the CTAs
 * are passed as the default slot so each page supplies its own.
 */
import Picture from './Picture.astro';
import Reveal from './Reveal.astro';
import HeroBlobs from './HeroBlobs.astro';

interface Props {
  backHref: string;
  backLabel: string;
  heading: string;
  image?: string;
  imageAlt?: string;
}
const { backHref, backLabel, heading, image, imageAlt } = Astro.props;
---
<section class="section relative overflow-hidden bg-gradient-to-b from-teal-50 via-white to-white">
  <HeroBlobs />
  <div class="container-tight relative grid md:grid-cols-2 gap-12 items-center">
    <Reveal>
      <slot name="before-eyebrow" />
      <p class="text-sm font-semibold uppercase tracking-wider text-coral-700">
        <a href={backHref} class="hover:text-coral-600">{backLabel}</a>
      </p>
      <h1 class="mt-3 text-4xl md:text-5xl lg:text-6xl leading-[1.05]">{heading}</h1>
      <slot />
    </Reveal>
    <div class="relative rounded-3xl overflow-hidden ring-1 ring-ink-100 shadow-xl shadow-teal-900/10 aspect-[4/5]">
      {image && <Picture src={image} size={800} alt={imageAlt} width={800} height={1000} priority />}
    </div>
  </div>
</section>
