---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';
import services from '../data/services.json';
import PageHero from '../components/PageHero.astro';
import SectionIntro from '../components/SectionIntro.astro';
import Reveal from '../components/Reveal.astro';
import InfoCard from '../components/InfoCard.astro';
import ContactCTACard from '../components/ContactCTACard.astro';
import { buildBreadcrumbSchema } from '../lib/schemas';
import ReviewStrip from '../components/ReviewStrip.astro';

const title = "Dog grooming prices in Hall Green | Keith's K9 Care";
const description = "Full published price guide with breed examples — small dogs from £40, medium from £50, large or doodles from £60 for a full groom. Hall Green, Wakefield WF4.";

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: "Home", url: `${site.url}/` },
  { name: "Pricing", url: `${site.url}/pricing/` },
]);

const addOns = [
  { label: "Single nail trim (between grooms)", from: 10 },
  { label: "Ear clean + check (between grooms)", from: 5 },
  { label: "Matted coat surcharge (light)", from: 10 },
  { label: "Anxious / nervous handling allowance", from: 10, note: "up to +£20 depending on time taken" },
  { label: "Severe matting strip-clip (welfare-first)", from: 60, note: "honestly assessed on the day" },
  { label: "Extra time for heavy coats or long gaps between grooms", from: 0, note: "priced by the half-hour" },
];
---
<Layout title={title} description={description} ogImage="/assets/photos/cockapoo-after-groom.jpg">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <PageHero
    eyebrow="Pricing"
    heading="No surprises. Prices on the page."
    body="Most local groomers won't tell you what they charge until you ring. We will. Prices start from the figures shown and may vary a little by breed, coat condition and behaviour — Keith will always confirm before he starts."
  />

  <ReviewStrip />

  <!-- BREED-BY-BREED MATRIX per service -->
  {services.map((s, si) => (
    <section class:list={["section", si % 2 === 0 ? '' : 'bg-teal-50/60']}>
      <div class="container-wide">
        <Reveal class="mb-8">
          <div class="flex flex-wrap items-baseline justify-between gap-4">
            <div class="max-w-2xl">
              <p class="text-sm font-semibold uppercase tracking-wider text-coral-700">{s.name}</p>
              <h2 class="mt-2 text-3xl md:text-4xl leading-tight">From £{s.fromPrice}.</h2>
              <p class="mt-3 text-ink-700 leading-relaxed">{s.summary}</p>
            </div>
            <div class="flex flex-col sm:flex-row gap-3">
              <a href={`/services/${s.slug}/`} class="btn-secondary">More on {s.name}</a>
            </div>
          </div>
        </Reveal>

        {s.breedExamples && s.breedExamples.length > 0 && (
          <div class="grid md:grid-cols-3 gap-4 md:gap-6">
            {s.breedExamples.map((tier: any, ti: number) => (
              <Reveal delay={ti * 80}>
                <div class="rounded-2xl bg-white ring-1 ring-ink-100 p-6 h-full">
                  <div class="flex items-baseline justify-between gap-3">
                    <h3 class="font-display text-lg text-ink-900">{tier.size}</h3>
                    <span class="font-semibold text-teal-700 text-lg whitespace-nowrap">from £{tier.from}</span>
                  </div>
                  <ul class="mt-4 space-y-1.5 text-sm text-ink-700">
                    {tier.breeds.map((b: string) => <li class="flex gap-2"><span class="text-coral-400">·</span><span>{b}</span></li>)}
                  </ul>
                </div>
              </Reveal>
            ))}
          </div>
        )}
      </div>
    </section>
  ))}

  <!-- ADD-ONS -->
  <section class="section">
    <div class="container-wide">
      <Reveal class="mb-8">
        <SectionIntro
          eyebrow="Add-ons & surcharges"
          heading="Anything extra is added honestly."
          description="If a coat needs more time than the standard tier, we'll say so up-front. Nothing's a surprise on the bill."
        />
      </Reveal>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {addOns.map((a, i) => (
          <Reveal delay={i * 60}>
            <div class="rounded-2xl bg-white ring-1 ring-ink-100 p-5 h-full">
              <div class="flex items-baseline justify-between gap-3">
                <h3 class="font-display text-base text-ink-900">{a.label}</h3>
                <span class="font-semibold text-teal-700 whitespace-nowrap">{a.from > 0 ? `from £${a.from}` : 'POA'}</span>
              </div>
              {a.note && <p class="mt-2 text-xs text-ink-500">{a.note}</p>}
            </div>
          </Reveal>
        ))}
      </div>
    </div>
  </section>

  <!-- HOW WE WORK -->
  <section class="section bg-ink-50/60">
    <div class="container-tight">
      <Reveal>
        <SectionIntro
          eyebrow="How pricing works"
          heading="Three rules."
        />
      </Reveal>
      <div class="mt-8 grid md:grid-cols-3 gap-5">
        {[
          { t: "Quoted before we start", b: "After meeting your dog and assessing the coat, Keith will confirm the price before the bath begins. No surprises after." },
          { t: "By coat, not stopwatch", b: "Two cockapoos can be £20 apart — one might be a tangle, one might be perfect. We price the work, not the diary slot." },
          { t: "Welfare wins", b: "If a severely matted coat can't be saved kindly, a clip-down is cheaper than de-matting and better for your dog. We'll always tell you." },
        ].map((c, i) => (
          <Reveal delay={i * 100}>
            <InfoCard heading={c.t}>{c.b}</InfoCard>
          </Reveal>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTACT CTA -->
  <section class="section">
    <div class="container-wide">
      <Reveal>
        <ContactCTACard heading="Got a breed or coat we haven't listed?" body="Send Keith a quick photo and he'll give you a proper price estimate before you book." />
      </Reveal>
    </div>
  </section>
</Layout>
