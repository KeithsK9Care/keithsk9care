---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';
import Reveal from '../components/Reveal.astro';

const title = "Thanks — we'll be in touch | Keith's K9 Care";
const description = "Thanks for your booking enquiry. Keith will reply personally, usually within an hour during opening times.";
---
<Layout title={title} description={description} noindex={true} hideWhatsApp={true}>
  <section class="section">
    <div class="container-tight text-center">
      <Reveal>
        <span class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-coral-50 text-coral-500 mb-6">
          <svg aria-hidden="true" class="w-10 h-10" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
          </svg>
        </span>
        <p class="text-sm font-semibold uppercase tracking-wider text-coral-500">Thanks!</p>
        <h1 class="mt-3 text-4xl md:text-5xl">Message received.</h1>
        <p class="mt-6 text-lg text-ink-700 leading-relaxed max-w-xl mx-auto">
          Keith will reply personally — usually within an hour during opening times (Tuesday to Saturday). For anything urgent, you can also call or WhatsApp <a href={`tel:${site.phoneIntl}`} class="text-teal-700 font-semibold hover:text-coral-500">{site.phone}</a>.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
          <a href="/" class="btn-primary">Back to home</a>
          <a href="/services/" class="btn-secondary">Browse services</a>
        </div>
      </Reveal>
    </div>
  </section>
</Layout>
