---
import Picture from '../Picture.astro';
import Reveal from '../Reveal.astro';
import copy from '../../data/copy/home.json';

const a = copy.about;
const imgs = copy.images;
---
<section class="section">
  <div class="container-tight grid md:grid-cols-5 gap-10 md:gap-14 items-center">
    <Reveal class="md:col-span-2">
      <div class="relative rounded-3xl overflow-hidden ring-1 ring-ink-100 aspect-square">
        <Picture src={imgs.aboutPhoto} size={800} alt={imgs.aboutPhotoAlt} width={800} height={800} />
      </div>
    </Reveal>
    <Reveal class="md:col-span-3" delay={120}>
      <p class="text-sm font-semibold uppercase tracking-wider text-coral-700">{a.eyebrow}</p>
      <h2 class="mt-3 text-3xl md:text-4xl leading-tight">{a.heading}</h2>
      <div class="mt-5 space-y-4 text-ink-700 leading-relaxed">
        {a.paragraphs.map(p => <p>{p}</p>)}
      </div>
      <a href={a.ctaHref} class="btn-ghost mt-6">
        {a.ctaText}
        <svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
    </Reveal>
  </div>
</section>
