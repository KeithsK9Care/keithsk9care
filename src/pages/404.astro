---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';
import Reveal from '../components/Reveal.astro';

const title = "Page not found | Keith's K9 Care";
const description = "The page you're looking for doesn't exist. Browse our services, see the price guide, or get in touch with Keith on 07926 471552.";
---
<Layout title={title} description={description} noindex={true} hideWhatsApp={true} ogImage="/assets/photos/golden-puppy-woodland-1.jpg">
  <section class="section">
    <div class="container-tight text-center">
      <Reveal>
        <p class="text-sm font-semibold uppercase tracking-wider text-coral-700">404</p>
        <h1 class="mt-3 text-4xl md:text-5xl">We couldn't find that page.</h1>
        <p class="mt-5 text-ink-700">Lost? Sit. Stay. Try one of these instead:</p>
        <div class="mt-8 grid sm:grid-cols-2 gap-3 max-w-md mx-auto">
          <a href="/" class="btn-primary justify-center">Home</a>
          <a href="/services/" class="btn-secondary justify-center">Services</a>
          <a href="/pricing/" class="btn-secondary justify-center">Pricing</a>
          <a href="/book/" class="btn-secondary justify-center">Get in touch</a>
        </div>
        <p class="mt-8 text-sm text-ink-600">
          Or call Keith on <a href={`tel:${site.phoneIntl}`} class="text-teal-700 font-semibold hover:text-coral-500">{site.phone}</a>.
        </p>
      </Reveal>
    </div>
  </section>
</Layout>
