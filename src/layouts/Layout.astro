---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import WhatsAppPopup from '../components/WhatsAppPopup.astro';
import StickyMobileCTA from '../components/StickyMobileCTA.astro';
import site from '../data/site.json';
import services from '../data/services.json';
import { buildLocalBusinessSchema } from '../lib/schemas';
import { ClientRouter } from 'astro:transitions';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  hideWhatsApp?: boolean;
  heroPreload?: string;   // path under /assets/photos/ — preloads webp + jpg for the LCP image
}

const {
  title,
  description,
  canonical = new URL(Astro.url.pathname, Astro.site).toString(),
  ogImage = '/assets/photos/golden-puppy-woodland-1.jpg',
  noindex = false,
  hideWhatsApp = false,
  heroPreload,
} = Astro.props;

// ogImage accepts either a full path ("/assets/photos/X.jpg") or a filename stub ("X").
// Stubs let the CMS use a simple Sveltia `select` widget. We normalise to a full path here.
const ogPath = ogImage.startsWith('/') ? ogImage : `/assets/photos/${ogImage}.jpg`;

const localBusiness = buildLocalBusinessSchema(site, services);
---
<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="theme-color" content="#007090" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />

  <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="192x192" href="/assets/logo-192.png" />
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />

  {noindex && <meta name="robots" content="noindex, nofollow" />}

  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="en_GB" />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(ogPath, Astro.site).toString()} />
  <meta property="og:site_name" content={site.name} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(ogPath, Astro.site).toString()} />

  <ClientRouter />
  <slot name="head" />

  <script type="application/ld+json" set:html={JSON.stringify(localBusiness)} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  {/* Non-blocking font load: preload as style, then activate. NoScript fallback for crawlers/JS-off. */}
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&display=swap" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&display=swap" media="print" onload="this.media='all'" />
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&display=swap" /></noscript>

  {/* Preload the hero image (LCP) — only if the page passes a heroPreload */}
  {heroPreload && (
    <>
      <link rel="preload" as="image" type="image/webp" href={`/assets/photos/${heroPreload}.webp`} fetchpriority="high" />
      <link rel="preload" as="image" type="image/jpeg" href={`/assets/photos/${heroPreload}.jpg`} fetchpriority="high" />
    </>
  )}
</head>
<body class="font-sans">
  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:px-4 focus:py-2 focus:bg-coral-500 focus:text-white focus:rounded-md">Skip to content</a>
  <Nav />
  <main id="main">
    <slot />
  </main>
  <Footer />
  <StickyMobileCTA />
  {!hideWhatsApp && <WhatsAppPopup />}
</body>
</html>
