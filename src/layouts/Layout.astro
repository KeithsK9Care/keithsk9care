---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import WhatsAppPopup from '../components/WhatsAppPopup.astro';
import StickyMobileCTA from '../components/StickyMobileCTA.astro';
import site from '../data/site.json';
import services from '../data/services.json';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  hideWhatsApp?: boolean;
}

const {
  title,
  description,
  canonical = new URL(Astro.url.pathname, Astro.site).toString(),
  ogImage = '/assets/photos/golden-puppy-woodland-1.jpg',
  noindex = false,
  hideWhatsApp = false,
} = Astro.props;

// Site-wide LocalBusiness + AnimalCareService JSON-LD
const localBusiness = {
  "@context": "https://schema.org",
  "@type": ["LocalBusiness", "AnimalCareService"],
  "@id": `${site.url}/#business`,
  "name": site.name,
  "description": site.tagline,
  "url": site.url,
  "telephone": site.phoneIntl,
  "email": site.email,
  "image": `${site.url}/assets/logo.png`,
  "logo": `${site.url}/assets/logo.png`,
  "priceRange": site.priceRange,
  "currenciesAccepted": "GBP",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": site.address.street,
    "addressLocality": site.address.locality,
    "addressRegion": site.address.region,
    "postalCode": site.address.postcode,
    "addressCountry": site.address.country
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": site.address.lat,
    "longitude": site.address.lng
  },
  "areaServed": site.serviceArea.map((name: string) => ({
    "@type": "Place",
    "name": name
  })),
  "openingHoursSpecification": site.hours.map((h: any) => ({
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": `https://schema.org/${h.day}`,
    "opens": h.open,
    "closes": h.close
  })),
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Dog Grooming Services",
    "itemListElement": services.map((s: any) => ({
      "@type": "Offer",
      "itemOffered": {
        "@type": "Service",
        "name": s.name,
        "description": s.summary,
        "url": `${site.url}/services/${s.slug}/`
      },
      "price": s.fromPrice,
      "priceCurrency": "GBP",
      "priceSpecification": {
        "@type": "PriceSpecification",
        "price": s.fromPrice,
        "priceCurrency": "GBP",
        "valueAddedTaxIncluded": true,
        "description": `From £${s.fromPrice}`
      }
    }))
  },
  "sameAs": [site.facebook]
};
---
<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#1899b5" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />

  <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="192x192" href="/assets/logo-192.png" />
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />

  {noindex && <meta name="robots" content="noindex, nofollow" />}

  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="en_GB" />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(ogImage, Astro.site).toString()} />
  <meta property="og:site_name" content={site.name} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(ogImage, Astro.site).toString()} />

  <slot name="head" />

  <script type="application/ld+json" set:html={JSON.stringify(localBusiness)} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&display=swap" rel="stylesheet" />
</head>
<body class="font-sans">
  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:px-4 focus:py-2 focus:bg-coral-500 focus:text-white focus:rounded-md">Skip to content</a>
  <Nav />
  <main id="main">
    <slot />
  </main>
  <Footer />
  <StickyMobileCTA />
  {!hideWhatsApp && <WhatsAppPopup />}
</body>
</html>
