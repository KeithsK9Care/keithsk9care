---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';
import copy from '../data/copy/privacy.json';
import LegalPage from '../components/LegalPage.astro';
import { buildBreadcrumbSchema } from '../lib/schemas';

const m = copy.meta;
const crumbs = [
  { name: "Home", url: `${site.url}/` },
  { name: "Privacy", url: `${site.url}/privacy/` },
];
const breadcrumbSchema = buildBreadcrumbSchema(crumbs);
---
<Layout title={m.title} description={m.description} ogImage={m.ogImage} schema={[breadcrumbSchema]}>
  <LegalPage copy={copy} crumbs={crumbs} />
</Layout>
