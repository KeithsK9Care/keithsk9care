---
import { reviews } from '../lib/content';
import site from '../data/site.json';
import ReviewCard from './ReviewCard.astro';
import Reveal from './Reveal.astro';

const featured = reviews.filter(r => r.featured).slice(0, 3);
if (featured.length === 0) featured.push(...reviews.slice(0, 3));
const avg = reviews.length > 0 ? (reviews.reduce((a, r) => a + r.rating, 0) / reviews.length).toFixed(1) : null;
---
{featured.length > 0 && (
  <section class="py-8 md:py-12 bg-teal-50/60">
    <div class="container-wide">
      <Reveal class="mb-6 flex flex-wrap items-baseline justify-between gap-4">
        <div>
          <p class="text-sm font-semibold uppercase tracking-wider text-coral-700">{site.reviewsEyebrow}</p>
          <p class="mt-1 text-sm text-ink-600">
            {avg && <span class="text-coral-500 mr-1" aria-hidden="true">★★★★★</span>}
            {avg && <strong class="text-ink-900">{avg}</strong>}
            {avg && <>from {reviews.length} {reviews.length === 1 ? 'review' : 'reviews'} ·</>}
            <a href="/reviews/" class="text-teal-700 font-semibold hover:text-coral-700 ml-1">{avg ? 'Read all' : 'Reviews'}</a>
          </p>
        </div>
      </Reveal>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {featured.map((r, i) => (
          <Reveal delay={i * 70}>
            <ReviewCard review={r} compact />
          </Reveal>
        ))}
      </div>
    </div>
  </section>
)}
