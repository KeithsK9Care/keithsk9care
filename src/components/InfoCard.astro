---
/**
 * Small content card with eyebrow + heading + body.
 * Used in qualifications, philosophy lists, feature breakdowns.
 */
export interface Props {
  eyebrow?: string;
  heading: string;
  headingTag?: 'h3' | 'h4';
}
const { eyebrow, heading, headingTag = 'h3' } = Astro.props;
const Heading = headingTag;
---
<div class="rounded-2xl bg-white ring-1 ring-ink-100 p-6 h-full">
  {eyebrow && <p class="text-xs font-semibold uppercase tracking-wider text-coral-500">{eyebrow}</p>}
  <Heading class:list={[eyebrow ? 'mt-2' : '', 'text-xl']}>{heading}</Heading>
  <div class="mt-3 text-ink-700 leading-relaxed">
    <slot />
  </div>
</div>
