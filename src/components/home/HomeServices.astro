---
import services from '../../data/services.json';
import ServiceCard from '../ServiceCard.astro';
import SectionIntro from '../SectionIntro.astro';
import Reveal from '../Reveal.astro';
---
<section class="section bg-teal-50/60">
  <div class="container-wide">
    <Reveal>
      <SectionIntro
        eyebrow="Services"
        heading="What we do — gently, properly, and at your dog's pace."
        description="Cockapoos, doodles, terriers, retrievers, small breeds — every coat type welcome. From puppy first grooms to senior tidies and hand-stripping."
      />
    </Reveal>

    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((s, i) => (
        <Reveal delay={i * 60}>
          <ServiceCard service={s} index={i} />
        </Reveal>
      ))}
    </div>
  </div>
</section>
