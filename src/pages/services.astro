---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';
import { services } from '../lib/content';
import copy from '../data/copy/services.json';
import SectionIntro from '../components/SectionIntro.astro';
import Reveal from '../components/Reveal.astro';
import ServiceCard from '../components/ServiceCard.astro';
import PageHero from '../components/PageHero.astro';
import ContactCTACard from '../components/ContactCTACard.astro';
import { buildBreadcrumbSchema } from '../lib/schemas';
import ReviewStrip from '../components/ReviewStrip.astro';

const m = copy.meta;
const h = copy.hero;
const trans = copy.transparency;
const cta = copy.contactCta;

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: "Home", url: `${site.url}/` },
  { name: "Services", url: `${site.url}/services/` },
]);
---
<Layout title={m.title} description={m.description} ogImage={m.ogImage}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <PageHero eyebrow={h.eyebrow} heading={h.heading} body={h.body} />

  <ReviewStrip />

  <!-- SERVICES GRID -->
  <section class="section">
    <div class="container-wide">
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((s, i) => (
          <Reveal delay={i * 60}>
            <ServiceCard service={s} index={i} />
          </Reveal>
        ))}
      </div>
    </div>
  </section>

  <!-- TRANSPARENCY CALLOUT -->
  <section class="section bg-teal-50/60">
    <div class="container-tight text-center">
      <Reveal>
        <SectionIntro
          eyebrow={trans.eyebrow}
          heading={trans.heading}
          description={trans.description}
          align="center"
        />
        <a href={trans.ctaHref} class="btn-primary mt-7">{trans.ctaText}</a>
      </Reveal>
    </div>
  </section>

  <!-- CONTACT CTA -->
  <section class="section">
    <div class="container-wide">
      <Reveal>
        <ContactCTACard heading={cta.heading} body={cta.body} />
      </Reveal>
    </div>
  </section>
</Layout>
