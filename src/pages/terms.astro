---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';
import copy from '../data/copy/terms.json';
import LegalPage from '../components/LegalPage.astro';
import { buildBreadcrumbSchema } from '../lib/schemas';

const m = copy.meta;
const breadcrumbSchema = buildBreadcrumbSchema([
  { name: "Home", url: `${site.url}/` },
  { name: "Terms", url: `${site.url}/terms/` },
]);
---
<Layout title={m.title} description={m.description} ogImage={m.ogImage} schema={[breadcrumbSchema]}>
  <LegalPage copy={copy} />
</Layout>
