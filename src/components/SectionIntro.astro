---
export interface Props {
  eyebrow: string;
  heading: string;
  description?: string;
  align?: 'left' | 'center';
  width?: 'narrow' | 'wide';
  headingClass?: string;
}
const { eyebrow, heading, description, align = 'left', width = 'narrow', headingClass = 'text-3xl md:text-4xl' } = Astro.props;
const widthCls = width === 'narrow' ? 'max-w-2xl' : 'max-w-3xl';
const alignCls = align === 'center' ? 'text-center mx-auto' : '';
---
<div class:list={[widthCls, alignCls]}>
  <p class="text-sm font-semibold uppercase tracking-wider text-coral-500">{eyebrow}</p>
  <h2 class:list={['mt-3', headingClass]}>{heading}</h2>
  {description && <p class="mt-4 text-ink-700 leading-relaxed">{description}</p>}
</div>
