---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';
import copy from '../data/copy/faq.json';
import SectionIntro from '../components/SectionIntro.astro';
import Reveal from '../components/Reveal.astro';
import FAQItem from '../components/FAQItem.astro';
import PageHero from '../components/PageHero.astro';
import ContactCTASection from '../components/ContactCTASection.astro';
import { faqs } from '../lib/content';
import { buildFAQSchema, buildBreadcrumbSchema } from '../lib/schemas';
import ReviewStrip from '../components/ReviewStrip.astro';

const m = copy.meta;
const h = copy.hero;
const cta = copy.contactCta;

// Group FAQs by topic via tags (config from copy.json)
const used = new Set();
const grouped = copy.groups.map((g: any) => {
  const items = faqs.filter((f: any) => !used.has(f.q) && f.tags.includes(g.tag));
  items.forEach((f: any) => used.add(f.q));
  return { ...g, items };
}).filter((g: any) => g.items.length > 0);

const general = faqs.filter((f: any) => !used.has(f.q));
if (general.length) grouped.push({ ...copy.generalGroup, items: general });

const faqSchema = buildFAQSchema(faqs);
const breadcrumbSchema = buildBreadcrumbSchema([
  { name: "Home", url: `${site.url}/` },
  { name: "FAQ", url: `${site.url}/faq/` },
]);
---
<Layout title={m.title} description={m.description} ogImage={m.ogImage} schema={[faqSchema, breadcrumbSchema]}>

  <PageHero eyebrow={h.eyebrow} heading={h.heading} body={h.body} />

  <ReviewStrip />

  <!-- GROUPED FAQS -->
  {grouped.map((g: any, gi: number) => (
    <section class:list={["section", gi % 2 === 0 ? '' : 'bg-teal-50/60']}>
      <div class="container-tight">
        <Reveal class="mb-8">
          <SectionIntro eyebrow={g.eyebrow} heading={g.heading} />
        </Reveal>
        <div class="space-y-3">
          {g.items.map((f: any, i: number) => (
            <Reveal delay={i * 50}>
              <FAQItem faq={f} open={gi === 0 && i === 0} />
            </Reveal>
          ))}
        </div>
      </div>
    </section>
  ))}

  <!-- CONTACT CTA -->
  <ContactCTASection heading={cta.heading} body={cta.body} />
</Layout>
