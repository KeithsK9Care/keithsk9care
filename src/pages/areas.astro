---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';
import { areas } from '../lib/content';
import copy from '../data/copy/areas.json';
import PageHero from '../components/PageHero.astro';
import Reveal from '../components/Reveal.astro';
import AreaPill from '../components/AreaPill.astro';
import ReviewStrip from '../components/ReviewStrip.astro';
import { buildBreadcrumbSchema } from '../lib/schemas';

const m = copy.meta;
const h = copy.hero;
const overview: string[] = copy.overview ?? [];

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: "Home", url: `${site.url}/` },
  { name: "Areas we cover", url: `${site.url}/areas/` },
]);
---
<Layout title={m.title} description={m.description} ogImage={m.ogImage} schema={[breadcrumbSchema]}>
  <PageHero
    eyebrow={h.eyebrow}
    heading={h.heading}
    body={h.body}
    align="left"
  />

  <ReviewStrip />

  <section class="section">
    <div class="container-tight">
      <Reveal class="flex flex-wrap gap-2">
        {areas.map(a => <AreaPill area={a} />)}
      </Reveal>

      <Reveal delay={200} class="mt-10 text-center">
        <a href="/book/" class="btn-primary">{copy.ctaText}</a>
      </Reveal>
    </div>
  </section>

  <!-- COVERAGE OVERVIEW -->
  {overview.length > 0 && (
    <section class="section bg-teal-50/60">
      <div class="container-tight">
        <div class="max-w-3xl space-y-5 text-lg text-ink-700 leading-relaxed">
          {overview.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </section>
  )}
</Layout>
