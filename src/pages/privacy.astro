---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';
import copy from '../data/copy/privacy.json';
import PageHero from '../components/PageHero.astro';
import Reveal from '../components/Reveal.astro';
import { buildBreadcrumbSchema } from '../lib/schemas';
import { expandPlaceholders } from '../lib/legal';

const m = copy.meta;
const h = copy.hero;
const sections: any[] = copy.sections;
const ex = (t: string) => expandPlaceholders(t, site);

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: "Home", url: `${site.url}/` },
  { name: "Privacy", url: `${site.url}/privacy/` },
]);
---
<Layout title={m.title} description={m.description} ogImage={m.ogImage}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <PageHero
    eyebrow={h.eyebrow}
    heading={h.heading}
    body={`${h.body} Last updated ${copy.lastUpdated}.`}
  />

  <section class="section">
    <div class="container-tight prose max-w-2xl">
      <Reveal class="space-y-6 text-ink-700 leading-relaxed">
        {sections.map((s: any, i: number) => (
          <div>
            <h2 class:list={['text-2xl font-display font-semibold text-ink-900', i === 0 && 'mt-0']}>{s.heading}</h2>
            {(s.intro || []).map((p: string) => <p set:html={ex(p)} />)}
            {s.bullets && s.bullets.length > 0 && (
              <ul class="space-y-2 list-disc pl-6 marker:text-coral-500">
                {s.bullets.map((b: string) => <li set:html={ex(b)} />)}
              </ul>
            )}
            {(s.outro || []).map((p: string) => <p set:html={ex(p)} />)}
          </div>
        ))}
      </Reveal>
    </div>
  </section>
</Layout>
