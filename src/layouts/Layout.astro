---
import '../styles/global.css';
import '@fontsource-variable/inter';
import '@fontsource-variable/fraunces';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import WhatsAppPopup from '../components/WhatsAppPopup.astro';
import StickyMobileCTA from '../components/StickyMobileCTA.astro';
import site from '../data/site.json';
import { services } from '../lib/content';
import { buildLocalBusinessSchema, buildGraph } from '../lib/schemas';
import { ClientRouter } from 'astro:transitions';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogImageAlt?: string;
  noindex?: boolean;
  hideWhatsApp?: boolean;
  heroPreload?: string;   // path under /assets/photos/ — preloads webp + jpg for the LCP image
  schema?: Array<object | null | false>;  // page-specific JSON-LD entities, merged into one @graph
}

const {
  title,
  description,
  canonical = new URL(Astro.url.pathname, Astro.site).toString(),
  ogImage = '/assets/og/default.jpg',
  ogImageAlt = "Keith's K9 Care — friendly local dog grooming in Hall Green, Wakefield WF4",
  noindex = false,
  hideWhatsApp = false,
  heroPreload,
  schema = [],
} = Astro.props;

// ogImage accepts either a full path ("/assets/photos/X.jpg") or a filename stub ("X").
// Stubs let the CMS use a simple Sveltia `select` widget. We normalise to a full path here.
const ogPath = ogImage.startsWith('/') ? ogImage : `/assets/photos/${ogImage}.jpg`;
// Only the branded 1200×630 cards under /assets/og/ should declare those exact dimensions;
// pages that point og:image at a raw photo omit width/height so scrapers don't mis-crop.
const isOgCard = ogPath.startsWith('/assets/og/');

const localBusiness = buildLocalBusinessSchema(site, services);
// Every page emits exactly one JSON-LD <script>: the sitewide LocalBusiness plus
// whatever entities the page passes, combined into a single @graph (Gold Standard #5).
const graph = buildGraph([localBusiness, ...schema]);
---
<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="theme-color" content="#007090" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />

  <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="192x192" href="/assets/logo-192.png" />
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />

  {noindex && <meta name="robots" content="noindex, nofollow" />}

  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="en_GB" />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(ogPath, Astro.site).toString()} />
  {isOgCard && <meta property="og:image:width" content="1200" />}
  {isOgCard && <meta property="og:image:height" content="630" />}
  <meta property="og:image:alt" content={ogImageAlt} />
  <meta property="og:site_name" content={site.name} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(ogPath, Astro.site).toString()} />
  <meta name="twitter:image:alt" content={ogImageAlt} />

  <ClientRouter />
  <slot name="head" />

  <script type="application/ld+json" set:html={JSON.stringify(graph)} />

  {/* Inter + Fraunces are self-hosted via @fontsource-variable (bundled into the CSS) — no third-party font request. */}

  {/* Preload the hero image (LCP) — only if the page passes a heroPreload */}
  {heroPreload && (
    <>
      <link rel="preload" as="image" type="image/webp" href={`/assets/photos/${heroPreload}.webp`} fetchpriority="high" />
      <link rel="preload" as="image" type="image/jpeg" href={`/assets/photos/${heroPreload}.jpg`} fetchpriority="high" />
    </>
  )}
</head>
<body class="font-sans">
  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:px-4 focus:py-2 focus:bg-coral-700 focus:text-white focus:rounded-md">Skip to content</a>
  <Nav />
  <main id="main">
    <slot />
  </main>
  <Footer />
  <StickyMobileCTA />
  {!hideWhatsApp && <WhatsAppPopup />}
</body>
</html>
