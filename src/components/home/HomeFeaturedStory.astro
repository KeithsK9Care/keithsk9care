---
import { stories } from '../../lib/content';
import home from '../../data/copy/home.json';
import StoryCard from '../StoryCard.astro';
import SectionIntro from '../SectionIntro.astro';
import Reveal from '../Reveal.astro';

const story = stories.find((s: any) => s.featured) || stories[0];
if (!story) return;
const fs = home.featuredStory;
---
{story && (
  <section class="section bg-ink-50/60">
    <div class="container-wide">
      <Reveal class="mb-10">
        <SectionIntro
          eyebrow={fs.eyebrow}
          heading={fs.heading}
          description={fs.description}
        />
      </Reveal>

      <Reveal delay={120}>
        <StoryCard story={story} featured />
      </Reveal>

      <Reveal delay={250}>
        <p class="mt-8 text-sm text-ink-600">
          <a href="/groom-stories/" class="text-teal-700 font-semibold hover:text-coral-700">See all groom stories →</a>
        </p>
      </Reveal>
    </div>
  </section>
)}
