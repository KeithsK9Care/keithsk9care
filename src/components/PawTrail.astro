---
// A short trail of brand paw prints that "walk down the page", drawing themselves as the
// section scrolls into view (pure-CSS view-timeline; static + fully drawn where unsupported
// or when prefers-reduced-motion). Paws point downward (direction of travel).
//
// Sits BEHIND the section's content: the host <section> must be `relative isolate` so this
// layer's negative z-index paints above the section background but below its content. The
// clip lives on THIS layer (overflow-hidden), never on the section — so a section can keep
// position:sticky children (e.g. HomeAbout) without breaking.
import { PAW_SHAPES } from '../lib/paw';

const VARIANTS: Record<string, string[]> = {
  // left-hand descent, prints toed down-right toward the centre
  left: [
    'left:5%;top:14%;width:40px;transform:rotate(128deg)',
    'left:12%;top:44%;width:34px;transform:rotate(150deg)',
    'left:7%;top:72%;width:42px;transform:rotate(122deg)',
  ],
  // right-hand descent, prints toed down-left toward the centre (mirrors `left`)
  right: [
    'right:6%;top:16%;width:40px;transform:rotate(-128deg)',
    'right:13%;top:46%;width:34px;transform:rotate(-150deg)',
    'right:8%;top:74%;width:42px;transform:rotate(-122deg)',
  ],
};

interface Props {
  /** which side the trail walks down */
  variant?: keyof typeof VARIANTS;
  /** stroke colour (Tailwind text-* token); default faint brand coral, safe on all light section bgs */
  colorClass?: string;
}
const { variant = 'left', colorClass = 'text-coral-300' } = Astro.props;
const paws = VARIANTS[variant] ?? VARIANTS.left;
---
<div class="paw-walk-layer absolute inset-0 -z-10 overflow-hidden pointer-events-none" aria-hidden="true">
  {paws.map((style, i) => (
    <svg
      class={`paw-walk paw-walk-${i + 1} absolute opacity-50 ${colorClass}`}
      style={style}
      viewBox="0 0 64 64"
      fill="none"
      stroke="currentColor"
      stroke-width="3.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      set:html={PAW_SHAPES}
    />
  ))}
</div>
