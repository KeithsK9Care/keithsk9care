---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';
import services from '../data/services.json';
import SectionIntro from '../components/SectionIntro.astro';
import Reveal from '../components/Reveal.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ContactCTACard from '../components/ContactCTACard.astro';
import { buildBreadcrumbSchema } from '../lib/schemas';

const title = "Dog grooming services in Hall Green, Wakefield | Keith's K9 Care";
const description = `Full grooms, puppy first grooms, bath & tidy, nail trims, de-matting and hand stripping. IPET-qualified, one dog at a time in Hall Green, Wakefield ${site.address.postcode}.`;

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: "Home", url: `${site.url}/` },
  { name: "Services", url: `${site.url}/services/` },
]);
---
<Layout title={title} description={description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <!-- HERO -->
  <section class="section bg-gradient-to-b from-teal-50 via-white to-white">
    <div class="container-tight text-center">
      <Reveal>
        <p class="text-sm font-semibold uppercase tracking-wider text-coral-500">Services</p>
        <h1 class="mt-3 text-4xl md:text-5xl lg:text-6xl leading-[1.05]">What we do.</h1>
        <p class="mt-6 text-lg text-ink-700 leading-relaxed max-w-2xl mx-auto">
          Six core services — from a 45-minute puppy intro right through to a full hand-stripped terrier groom. Every coat type welcome, every dog at their own pace.
        </p>
      </Reveal>
    </div>
  </section>

  <!-- SERVICES GRID -->
  <section class="section">
    <div class="container-wide">
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((s, i) => (
          <Reveal delay={i * 60}>
            <ServiceCard service={s} index={i} />
          </Reveal>
        ))}
      </div>
    </div>
  </section>

  <!-- TRANSPARENCY CALLOUT -->
  <section class="section bg-teal-50/60">
    <div class="container-tight text-center">
      <Reveal>
        <SectionIntro
          eyebrow="No surprises"
          heading="All our prices are published."
          description="Most local groomers won't tell you what they charge until you ring. We do — small dogs from £40, medium from £50, large or doodles from £60 for a full groom. Surcharges are listed too."
          align="center"
        />
        <a href="/pricing/" class="btn-primary mt-7">See the full price guide</a>
      </Reveal>
    </div>
  </section>

  <!-- CONTACT CTA -->
  <section class="section">
    <div class="container-wide">
      <Reveal>
        <ContactCTACard heading="Not sure which service is right for your dog?" body="Drop Keith a quick message — he'll help you pick the right slot based on coat, age and any nerves." />
      </Reveal>
    </div>
  </section>
</Layout>
