---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';
import services from '../data/services.json';
import areas from '../data/areas.json';
import faqs from '../data/faqs.json';

const homepageFaqs = faqs.filter((f: any) => f.tags.includes('home')).slice(0, 5);

// Page-specific FAQPage schema
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": homepageFaqs.map((f: any) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.a
    }
  }))
};

const title = "Dog Grooming in Newmillerdam, Crigglestone & Wakefield | Keith's K9 Care";
const description = "Friendly, professional dog grooming from an IPET-qualified groomer's home salon in Newmillerdam, WF4. One dog at a time, in a quiet home — not a busy salon. Serving Wakefield, Crigglestone, Sandal, Horbury and surrounding villages.";
---
<Layout title={title} description={description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- ============ HERO ============ -->
  <section class="relative overflow-hidden bg-gradient-to-b from-teal-50 via-white to-white">
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute -top-24 -right-24 w-96 h-96 bg-coral-100 rounded-full blur-3xl opacity-50"></div>
      <div class="absolute top-32 -left-24 w-96 h-96 bg-teal-100 rounded-full blur-3xl opacity-40"></div>
    </div>

    <div class="container-wide relative pt-12 pb-20 md:pt-20 md:pb-28 grid md:grid-cols-2 gap-12 items-center">
      <div>
        <span class="inline-flex items-center gap-2 rounded-full bg-white shadow-sm ring-1 ring-ink-100 px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-teal-700">
          <span class="w-2 h-2 rounded-full bg-coral-500"></span>
          Newmillerdam · WF4 3QJ
        </span>
        <h1 class="mt-6 text-4xl md:text-5xl lg:text-6xl leading-[1.05]">
          Friendly dog grooming in <span class="text-teal-600">Newmillerdam</span>,<br class="hidden md:block" />
          <span class="text-coral-500">Crigglestone</span> & across Wakefield.
        </h1>
        <p class="mt-6 text-lg md:text-xl text-ink-700 leading-relaxed max-w-xl">
          Your dog deserves to look and feel their best. Whether they've been rolling through Newmillerdam woods or turned the garden into a mud bath — Keith's K9 Care is here to get them back to their brilliant best.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row gap-3">
          <a href="/book/" class="btn-primary">Book a Groom</a>
          <a href="/pricing/" class="btn-secondary">See Prices</a>
        </div>

        <ul class="mt-10 grid grid-cols-2 sm:grid-cols-4 gap-4 max-w-xl">
          {site.trustPoints.map(p => (
            <li class="flex flex-col items-start">
              <svg class="w-5 h-5 text-coral-500 mb-1" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              <span class="text-sm font-semibold text-ink-800 leading-tight">{p}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="relative">
        <div class="relative rounded-3xl overflow-hidden ring-1 ring-ink-100 shadow-2xl shadow-teal-900/10 aspect-[4/5]">
          <picture>
            <source srcset="/assets/photos/golden-puppy-woodland-1.webp" type="image/webp" />
            <img src="/assets/photos/golden-puppy-woodland-1.jpg" alt="Golden retriever puppy in Newmillerdam woodland — Keith's K9 Care" width="800" height="1000" class="w-full h-full object-cover" loading="eager" fetchpriority="high" />
          </picture>
        </div>
        <div class="absolute -bottom-6 -left-6 hidden md:block bg-white rounded-2xl shadow-xl ring-1 ring-ink-100 px-5 py-4 max-w-[200px]">
          <div class="flex items-center gap-2 text-coral-500 mb-1">
            {[1,2,3,4,5].map(() => <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.957a1 1 0 00.95.69h4.162c.969 0 1.371 1.24.588 1.81l-3.37 2.448a1 1 0 00-.364 1.118l1.287 3.958c.3.922-.755 1.688-1.539 1.118l-3.37-2.448a1 1 0 00-1.175 0l-3.371 2.448c-.783.57-1.838-.197-1.539-1.118l1.287-3.958a1 1 0 00-.364-1.118L2.05 9.385c-.783-.57-.38-1.81.588-1.81h4.162a1 1 0 00.95-.69l1.286-3.957z"/></svg>)}
          </div>
          <p class="text-sm font-semibold text-ink-900 leading-tight">IPET qualified · Mrs B's Grooming Academy, Leeds</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ ABOUT TEASER ============ -->
  <section class="section">
    <div class="container-tight grid md:grid-cols-5 gap-10 md:gap-14 items-center">
      <div class="md:col-span-2">
        <div class="relative rounded-3xl overflow-hidden ring-1 ring-ink-100 aspect-square">
          <picture>
            <source srcset="/assets/photos/keith-with-cocker-spaniel-800.webp" type="image/webp" />
            <img src="/assets/photos/keith-with-cocker-spaniel-800.jpg" alt="Keith Kershaw with a cocker spaniel in his home grooming salon" width="800" height="800" class="w-full h-full object-cover" loading="lazy" />
          </picture>
        </div>
      </div>
      <div class="md:col-span-3">
        <p class="text-sm font-semibold uppercase tracking-wider text-coral-500">Meet Keith</p>
        <h2 class="mt-3 text-3xl md:text-4xl leading-tight">From the law to the grooming table.</h2>
        <div class="mt-5 space-y-4 text-ink-700 leading-relaxed">
          <p>After a successful career in law, Keith and his wife welcomed two golden retriever brothers — Ringo and Rolo — into their lives during lockdown. What followed was a crash course in mud, puddles, unidentifiable countryside discoveries, and more baths than anyone had bargained for.</p>
          <p>Somewhere in all that, Keith discovered he loved the grooming process — the calm of it, the care, the transformation at the end. He went on to qualify with the IPET Network at Mrs B's Grooming Academy in Leeds, where his trainers noted his natural ability to put dogs at ease.</p>
        </div>
        <a href="/about/" class="btn-ghost mt-6">
          Read Keith's full story
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ============ SERVICES ============ -->
  <section class="section bg-teal-50/60">
    <div class="container-wide">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold uppercase tracking-wider text-coral-500">Services</p>
        <h2 class="mt-3 text-3xl md:text-4xl">What we do — gently, properly, and at your dog's pace.</h2>
      </div>

      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((s, i) => (
          <a href={`/services/${s.slug}/`} class="group rounded-2xl bg-white ring-1 ring-ink-100 p-6 hover:ring-coral-300 hover:shadow-lg hover:-translate-y-0.5 transition">
            <div class="flex items-center justify-between">
              <span class="inline-flex items-center justify-center w-11 h-11 rounded-xl bg-coral-50 text-coral-500">
                <span class="font-display font-bold">{i + 1}</span>
              </span>
              <span class="text-xs font-semibold uppercase tracking-wider text-ink-500">from £{s.fromPrice}</span>
            </div>
            <h3 class="mt-4 text-xl">{s.name}</h3>
            <p class="mt-2 text-sm text-ink-600 leading-relaxed">{s.summary}</p>
            <span class="inline-flex items-center gap-1 mt-5 text-sm font-semibold text-teal-700 group-hover:text-coral-500">
              Details
              <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ PRICING TEASER (full table inline — transparency play) ============ -->
  <section class="section">
    <div class="container-wide">
      <div class="grid md:grid-cols-3 gap-12 md:items-start">
        <div class="md:col-span-1">
          <p class="text-sm font-semibold uppercase tracking-wider text-coral-500">Pricing</p>
          <h2 class="mt-3 text-3xl md:text-4xl">No surprises. Prices on the page.</h2>
          <p class="mt-5 text-ink-700 leading-relaxed">Most local groomers won't tell you what they charge until you ring. We will. Final price varies a little by breed, coat and behaviour — and we always confirm before we start.</p>
          <a href="/pricing/" class="btn-ghost mt-5">
            See full price guide
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>

        <div class="md:col-span-2 rounded-3xl ring-1 ring-ink-100 bg-white overflow-hidden">
          {services.map((s, i) => (
            <div class={`p-6 md:p-7 ${i > 0 ? 'border-t border-ink-100' : ''}`}>
              <div class="flex flex-wrap items-baseline justify-between gap-3">
                <h3 class="text-lg font-display font-semibold text-ink-900">{s.name}</h3>
                <span class="text-sm text-ink-500">{s.duration}</span>
              </div>
              <ul class="mt-3 grid sm:grid-cols-3 gap-2 text-sm">
                {s.tiers.map(t => (
                  <li class="flex justify-between gap-3 rounded-lg bg-ink-50 px-3 py-2">
                    <span class="text-ink-700">{t.label}</span>
                    <span class="font-semibold text-teal-700">from £{t.from}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
          <div class="bg-teal-50 px-6 md:px-7 py-4 text-xs text-ink-700">
            Surcharges where applicable — matted coats from £10 (severe assessed on the day) · nervous, anxious or reactive dogs +£10–£20.
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ THE SALON ============ -->
  <section class="section bg-ink-50/60">
    <div class="container-wide">
      <div class="max-w-2xl mb-10">
        <p class="text-sm font-semibold uppercase tracking-wider text-coral-500">The salon</p>
        <h2 class="mt-3 text-3xl md:text-4xl">One dog. One groomer. One quiet room.</h2>
        <p class="mt-4 text-ink-700 leading-relaxed">No kennels. No other dogs barking through the wall. A purpose-built home salon in a converted garage — fully equipped, calm, and set up around your dog's comfort.</p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-3 md:gap-5">
        {[
          { src: 'cockapoo-after-groom', alt: 'Cockapoo after a full groom on the table in Keith\'s K9 Care home salon, Castle Meadows WF4' },
          { src: 'keith-with-grey-schnauzer', alt: 'Keith with a freshly-groomed grey schnauzer in the home salon' },
          { src: 'black-poodle-after-groom', alt: 'Black miniature poodle after a full groom at Keith\'s K9 Care, Newmillerdam' },
          { src: 'keith-with-border-terrier', alt: 'Keith finishing a border terrier groom in the home salon' },
          { src: 'cocker-spaniel-after-groom', alt: 'Cocker spaniel after a hand-stripped groom' },
          { src: 'cockapoo-portrait', alt: 'Bright-coated cockapoo after a full groom at Keith\'s K9 Care' },
        ].map(p => (
          <div class="relative rounded-2xl overflow-hidden aspect-square ring-1 ring-ink-100">
            <picture>
              <source srcset={`/assets/photos/${p.src}-800.webp`} type="image/webp" />
              <img src={`/assets/photos/${p.src}-800.jpg`} alt={p.alt} width="800" height="800" class="w-full h-full object-cover" loading="lazy" />
            </picture>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ AREAS WE COVER ============ -->
  <section class="section">
    <div class="container-wide">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold uppercase tracking-wider text-coral-500">Areas we cover</p>
        <h2 class="mt-3 text-3xl md:text-4xl">Local to Newmillerdam, serving the wider Wakefield area.</h2>
        <p class="mt-4 text-ink-700 leading-relaxed">Most of our customers live within a 5-minute drive — but we pick up regulars from across the Wakefield villages and into north Barnsley.</p>
      </div>

      <div class="mt-10 flex flex-wrap gap-2">
        {areas.map(a => (
          <a href={`/areas/${a.slug}/`} class="inline-flex items-center gap-2 rounded-full ring-1 ring-ink-200 bg-white px-4 py-2 text-sm font-semibold text-ink-800 hover:ring-coral-400 hover:text-coral-600 transition">
            <svg class="w-3.5 h-3.5 text-teal-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/></svg>
            {a.name}
            <span class="text-xs text-ink-400">{a.driveMinutes} min</span>
          </a>
        ))}
      </div>

      <a href="/areas/" class="btn-ghost mt-8">
        See all areas and what we do there
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section class="section bg-teal-50/60">
    <div class="container-tight">
      <div class="max-w-2xl mb-10">
        <p class="text-sm font-semibold uppercase tracking-wider text-coral-500">Common questions</p>
        <h2 class="mt-3 text-3xl md:text-4xl">Before your dog's first visit.</h2>
      </div>

      <div class="space-y-3">
        {homepageFaqs.map((f, i) => (
          <details class="group rounded-2xl bg-white ring-1 ring-ink-100 open:ring-coral-200 open:shadow-sm" open={i === 0}>
            <summary class="cursor-pointer list-none p-5 md:p-6 flex items-center justify-between gap-4">
              <span class="font-display text-lg font-semibold text-ink-900">{f.q}</span>
              <svg class="w-5 h-5 text-coral-500 transition-transform group-open:rotate-180 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-5 md:px-6 pb-5 md:pb-6 text-ink-700 leading-relaxed">
              <p>{f.a}</p>
            </div>
          </details>
        ))}
      </div>

      <p class="mt-8 text-sm text-ink-600">
        More on the <a href="/faq/" class="text-teal-700 font-semibold hover:text-coral-500">full FAQ page</a>.
      </p>
    </div>
  </section>

  <!-- ============ CONTACT CTA ============ -->
  <section class="section">
    <div class="container-wide">
      <div class="relative rounded-3xl overflow-hidden bg-gradient-to-br from-teal-700 to-teal-800 p-8 md:p-14 text-white">
        <div class="absolute -top-20 -right-20 w-80 h-80 bg-coral-400/20 rounded-full blur-3xl"></div>
        <div class="relative grid md:grid-cols-2 gap-10 items-center">
          <div>
            <h2 class="text-3xl md:text-4xl text-white leading-tight">Ready to get your pup looking their best?</h2>
            <p class="mt-4 text-teal-100 leading-relaxed">Give Keith a call or message — he's always happy to have a quick chat about your dog before booking. No bots, no answering service.</p>
            <div class="mt-7 flex flex-col sm:flex-row gap-3">
              <a href={`tel:${site.phoneIntl}`} class="inline-flex items-center justify-center gap-2 rounded-full bg-white text-teal-700 font-semibold px-6 py-3 hover:bg-coral-50 transition">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/></svg>
                {site.phone}
              </a>
              <a href={`https://wa.me/${site.whatsappIntl}`} target="_blank" rel="noopener" class="inline-flex items-center justify-center gap-2 rounded-full bg-whatsapp text-white font-semibold px-6 py-3 hover:bg-green-600 transition">
                WhatsApp Keith
              </a>
            </div>
            <p class="mt-5 text-sm text-teal-200">
              Or email <a href={`mailto:${site.email}`} class="underline hover:text-white">{site.email}</a>
            </p>
          </div>
          <div class="rounded-2xl bg-white/10 backdrop-blur ring-1 ring-white/20 p-6">
            <p class="text-xs font-semibold uppercase tracking-wider text-coral-300 mb-2">Find us</p>
            <address class="not-italic text-white text-lg leading-relaxed">
              {site.address.street}<br/>
              {site.address.locality}, {site.address.region}<br/>
              {site.address.postcode}
            </address>
            <a href={`https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(site.address.street + ', ' + site.address.postcode)}`} target="_blank" rel="noopener" class="inline-flex items-center gap-2 mt-4 text-coral-300 font-semibold hover:text-coral-200">
              Get directions
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
