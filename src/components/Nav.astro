---
import site from '../data/site.json';
import global from '../data/global.json';
const pathname = Astro.url.pathname;
const isActive = (p: string) => pathname === p || (p !== '/' && pathname.startsWith(p));

const links = [
  { href: '/services/',       label: 'Services' },
  { href: '/pricing/',        label: 'Pricing' },
  { href: '/areas/',          label: 'Areas' },
  { href: '/groom-stories/',  label: 'Groom Stories' },
  { href: '/reviews/',        label: 'Reviews' },
  { href: '/about/',          label: 'About' },
  { href: '/faq/',            label: 'FAQ' },
];
---
<header class="sticky top-0 z-40 bg-white/85 backdrop-blur-md backdrop-saturate-150 border-b border-ink-100/70">
  <div class="container-wide flex items-center justify-between h-16 md:h-20">
    <a href="/" class="flex items-center shrink-0" aria-label="Keith's K9 Care home">
      <picture>
        <source srcset="/assets/logo-tight.webp" type="image/webp" />
        <img src="/assets/logo-tight.png" alt="" width="109" height="94" class="h-12 w-auto md:h-16" loading="eager" decoding="async" />
      </picture>
    </a>

    <nav class="hidden lg:flex items-center gap-6" aria-label="Main">
      {links.map(({ href, label }) => (
        <a href={href} class={`text-sm font-semibold transition ${isActive(href) ? 'text-coral-700' : 'text-ink-700 hover:text-teal-700'}`}>{label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a href={`tel:${site.phoneIntl}`} class="hidden md:inline-flex items-center gap-2 text-sm font-semibold text-teal-700 hover:text-teal-900 whitespace-nowrap">
        <svg aria-hidden="true" class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/></svg>
        {site.phone}
      </a>
      <a href="/book/" class="hidden md:inline-flex btn-primary !py-2 !px-5 text-sm whitespace-nowrap">{global.cta.book}</a>
      <button id="kk9-nav-toggle" type="button" class="lg:hidden p-2 -mr-2 rounded-lg hover:bg-ink-50 focus:outline-none focus:ring-2 focus:ring-coral-400 relative z-[60]" aria-label="Open menu" aria-expanded="false" aria-controls="kk9-nav-drawer">
        <svg id="kk9-nav-icon-open" aria-hidden="true" class="w-6 h-6 text-ink-800" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
        <svg id="kk9-nav-icon-close" aria-hidden="true" class="hidden w-6 h-6 text-ink-800" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
  </div>
</header>

<!-- FULL-SCREEN MOBILE DRAWER (fades in/out) -->
<div
  id="kk9-nav-drawer"
  class="lg:hidden fixed inset-0 z-50 print:hidden flex flex-col pointer-events-none opacity-0 transition-opacity duration-300 ease-out"
  aria-hidden="true"
  inert
>
  <!-- Backdrop (also click-to-close) -->
  <div id="kk9-nav-backdrop" class="absolute inset-0 bg-white/95 backdrop-blur-2xl backdrop-saturate-150"></div>

  <!-- Close button (over the backdrop, separate from header toggle) -->
  <button id="kk9-nav-close" type="button" class="absolute top-4 right-4 z-10 p-3 rounded-lg hover:bg-ink-50 focus:outline-none focus:ring-2 focus:ring-coral-400" aria-label="Close menu">
    <svg aria-hidden="true" class="w-7 h-7 text-ink-800" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
  </button>

  <!-- Logo at top -->
  <div class="relative pt-6 pl-5 pointer-events-none">
    <a href="/" data-kk9-nav-link class="inline-flex items-center pointer-events-auto" aria-label="Keith's K9 Care home">
      <picture>
        <source srcset="/assets/logo-tight.webp" type="image/webp" />
        <img src="/assets/logo-tight.png" alt="" width="109" height="94" class="h-12 w-auto" loading="eager" decoding="async" />
      </picture>
    </a>
  </div>

  <!-- Nav links -->
  <nav class="relative flex-1 min-h-0 flex flex-col px-8 pt-4 pb-10 pointer-events-none" aria-label="Mobile">
    <div class="flex-1 min-h-0 overflow-y-auto flex flex-col justify-center space-y-0.5 pointer-events-auto">
      {links.map(({ href, label }) => (
        <a href={href} data-kk9-nav-link class={`block py-2 text-2xl font-display font-semibold transition ${isActive(href) ? 'text-coral-700' : 'text-ink-800 hover:text-teal-700'}`}>{label}</a>
      ))}
    </div>
    <div class="mt-6 flex flex-col sm:flex-row gap-3 pointer-events-auto">
      <a href="/book/" data-kk9-nav-link class="btn-primary justify-center">{global.cta.book}</a>
      <a href={`tel:${site.phoneIntl}`} data-kk9-nav-link class="btn-secondary justify-center">Call {site.phone}</a>
      <a href={`https://wa.me/${site.whatsappIntl}`} target="_blank" rel="noopener" class="inline-flex items-center justify-center gap-2 rounded-full bg-whatsapp px-6 py-3 font-semibold text-white text-sm">WhatsApp</a>
    </div>
  </nav>
</div>

<script is:inline>
  (function () {
    function armNav() {
      var toggle    = document.getElementById('kk9-nav-toggle');
      var drawer    = document.getElementById('kk9-nav-drawer');
      var closeBtn  = document.getElementById('kk9-nav-close');
      var backdrop  = document.getElementById('kk9-nav-backdrop');
      var iconOpen  = document.getElementById('kk9-nav-icon-open');
      var iconClose = document.getElementById('kk9-nav-icon-close');
      if (!toggle || !drawer) return;
      if (toggle.dataset.armed === '1') return;
      toggle.dataset.armed = '1';

      function open() {
        drawer.classList.remove('pointer-events-none', 'opacity-0');
        drawer.classList.add('opacity-100');
        drawer.setAttribute('aria-hidden', 'false');
        drawer.removeAttribute('inert');
        toggle.setAttribute('aria-expanded', 'true');
        toggle.setAttribute('aria-label', 'Close menu');
        if (iconOpen)  iconOpen.classList.add('hidden');
        if (iconClose) iconClose.classList.remove('hidden');
        document.documentElement.classList.add('overflow-hidden', 'kk9-menu-open');
        document.body.classList.add('overflow-hidden');
      }
      function close() {
        drawer.classList.add('opacity-0');
        drawer.classList.remove('opacity-100');
        drawer.setAttribute('aria-hidden', 'true');
        drawer.setAttribute('inert', '');
        setTimeout(function () { drawer.classList.add('pointer-events-none'); }, 300);
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Open menu');
        if (iconOpen)  iconOpen.classList.remove('hidden');
        if (iconClose) iconClose.classList.add('hidden');
        document.documentElement.classList.remove('overflow-hidden', 'kk9-menu-open');
        document.body.classList.remove('overflow-hidden');
      }
      function isOpen() { return !drawer.classList.contains('opacity-0'); }

      toggle.addEventListener('click', function () { isOpen() ? close() : open(); });
      if (closeBtn)  closeBtn.addEventListener('click', close);
      if (backdrop)  backdrop.addEventListener('click', close);

      drawer.querySelectorAll('[data-kk9-nav-link]').forEach(function (a) {
        a.addEventListener('click', close);
      });

      document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && isOpen()) close(); });

      var mq = window.matchMedia('(min-width: 1024px)');
      if (mq.addEventListener) mq.addEventListener('change', function (e) { if (e.matches && isOpen()) close(); });
    }
    armNav();
    document.addEventListener('astro:page-load', armNav);
  })();
</script>
