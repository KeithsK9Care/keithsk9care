---
/**
 * Repeating page hero: eyebrow → H1 → body → optional CTAs, with an OPTIONAL photo
 * on the right. When `photo` is set the hero becomes a two-column band (text left,
 * image right); otherwise it's the single-column text hero (left- or centre-aligned).
 * Used on /about/, /services/, /areas/, /faq/, /pricing/, /reviews/, /groom-stories/,
 * /book/ and the area detail pages. The HOMEPAGE hero is bespoke (HomeHero.astro).
 */
import Picture from './Picture.astro';

export interface Props {
  eyebrow: string;
  heading: string;
  body?: string;
  align?: 'left' | 'center';
  surface?: 'gradient' | 'plain';
  photo?: string;
  photoAlt?: string;
}
const { eyebrow, heading, body, align = 'center', surface = 'gradient', photo, photoAlt = '' } = Astro.props;
const surfaceCls = surface === 'gradient' ? 'bg-gradient-to-b from-teal-50 via-white to-white' : '';
const hasPhoto = !!photo;
const alignCls = align === 'center' ? 'text-center mx-auto' : '';
---
<section class:list={['section', surfaceCls]}>
  <div class="container-tight">
    {hasPhoto ? (
      <div class="grid md:grid-cols-5 gap-10 md:gap-14 items-center">
        <div class="md:col-span-3">
          <slot name="before-eyebrow" />
          <p class="text-sm font-semibold uppercase tracking-wider text-coral-700">{eyebrow}</p>
          <h1 class="mt-3 text-4xl md:text-5xl lg:text-6xl leading-[1.05]">{heading}</h1>
          {body && <p class="mt-6 text-lg text-ink-700 leading-relaxed max-w-xl">{body}</p>}
          <div class="mt-7 flex flex-wrap gap-3"><slot /></div>
        </div>
        <div class="md:col-span-2">
          <div class="relative rounded-3xl overflow-hidden ring-1 ring-ink-100 shadow-xl shadow-teal-900/10 aspect-[4/5]">
            <Picture src={photo} size={800} alt={photoAlt} width={800} height={1000} priority />
          </div>
        </div>
      </div>
    ) : (
      <div class:list={[alignCls, 'max-w-3xl']}>
        <slot name="before-eyebrow" />
        <p class="text-sm font-semibold uppercase tracking-wider text-coral-700">{eyebrow}</p>
        <h1 class="mt-3 text-4xl md:text-5xl lg:text-6xl leading-[1.05]">{heading}</h1>
        {body && <p class:list={['mt-6 text-lg text-ink-700 leading-relaxed', align === 'center' ? 'max-w-2xl mx-auto' : 'max-w-xl']}>{body}</p>}
        <div class:list={['mt-7 flex flex-wrap gap-3', align === 'center' ? 'justify-center' : '']}><slot /></div>
      </div>
    )}
  </div>
</section>
