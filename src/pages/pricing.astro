---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';
import { services } from '../lib/content';
import copy from '../data/copy/pricing.json';
import PageHero from '../components/PageHero.astro';
import SectionIntro from '../components/SectionIntro.astro';
import Reveal from '../components/Reveal.astro';
import InfoCard from '../components/InfoCard.astro';
import PriceCard from '../components/PriceCard.astro';
import ContactCTASection from '../components/ContactCTASection.astro';
import { buildBreadcrumbSchema } from '../lib/schemas';
import ReviewStrip from '../components/ReviewStrip.astro';

const m = copy.meta;
const h = copy.hero;
const addOns = copy.addOns;
const addOnsIntro = copy.addOnsIntro;
const how = copy.howPricingWorks;
const cta = copy.contactCta;

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: "Home", url: `${site.url}/` },
  { name: "Pricing", url: `${site.url}/pricing/` },
]);
---
<Layout title={m.title} description={m.description} ogImage={m.ogImage} schema={[breadcrumbSchema]}>

  <PageHero eyebrow={h.eyebrow} heading={h.heading} body={h.body} align="left" photo={h.photo} photoAlt={h.photoAlt} />

  <ReviewStrip />

  <!-- BREED-BY-BREED MATRIX per service -->
  {services.map((s, si) => (
    <section class:list={["section", si % 2 === 0 ? '' : 'bg-teal-50/60']}>
      <div class="container-wide">
        <Reveal class="mb-8">
          <div class="flex flex-wrap items-baseline justify-between gap-4">
            <div class="max-w-2xl">
              <p class="text-sm font-semibold uppercase tracking-wider text-coral-700">{s.name}</p>
              <h2 class="mt-2 text-3xl md:text-4xl leading-tight">From £{s.fromPrice}.</h2>
              <p class="mt-3 text-ink-700 leading-relaxed">{s.summary}</p>
            </div>
            <div class="flex flex-col sm:flex-row gap-3">
              <a href={`/services/${s.slug}/`} class="btn-secondary">More on {s.name}</a>
            </div>
          </div>
        </Reveal>

        {s.breedExamples && s.breedExamples.length > 0 && (
          <div class="grid md:grid-cols-3 gap-4 md:gap-6">
            {s.breedExamples.map((tier: any, ti: number) => (
              <Reveal delay={ti * 80}>
                <PriceCard label={tier.size} from={tier.from} bullets={tier.breeds} />
              </Reveal>
            ))}
          </div>
        )}
      </div>
    </section>
  ))}

  <!-- ADD-ONS -->
  <section class="section">
    <div class="container-wide">
      <Reveal class="mb-8">
        <SectionIntro
          eyebrow={addOnsIntro.eyebrow}
          heading={addOnsIntro.heading}
          description={addOnsIntro.description}
        />
      </Reveal>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {addOns.map((a: any, i: number) => (
          <Reveal delay={i * 60}>
            <PriceCard label={a.label} from={a.from} note={a.note} size="sm" />
          </Reveal>
        ))}
      </div>
    </div>
  </section>

  <!-- HOW WE WORK -->
  <section class="section bg-ink-50/60">
    <div class="container-tight">
      <Reveal>
        <SectionIntro eyebrow={how.eyebrow} heading={how.heading} />
      </Reveal>
      <div class="mt-8 grid md:grid-cols-3 gap-5">
        {how.cards.map((c: any, i: number) => (
          <Reveal delay={i * 100}>
            <InfoCard heading={c.t}>{c.b}</InfoCard>
          </Reveal>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTACT CTA -->
  <ContactCTASection heading={cta.heading} body={cta.body} />
</Layout>
