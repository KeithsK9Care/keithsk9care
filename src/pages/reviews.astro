---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';
import { reviews } from '../lib/content';
import copy from '../data/copy/reviews.json';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import ReviewCard from '../components/ReviewCard.astro';
import Reveal from '../components/Reveal.astro';
import ContactCTASection from '../components/ContactCTASection.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { buildReviewSchema, buildAggregateRatingSchema, buildBreadcrumbSchema } from '../lib/schemas';

const m = copy.meta;
const h = copy.hero;
const cta = copy.contactCta;

const sorted = [...reviews].sort((a, b) => (b.date || '').localeCompare(a.date || ''));
const ratings = reviews.map(r => r.rating);
const hasReviews = reviews.length > 0;
const avg = hasReviews ? (ratings.reduce((a, b) => a + b, 0) / ratings.length).toFixed(1) : '0';

const heading = hasReviews
  ? h.headingWithReviewsTemplate
      .replace('{avg}', String(avg))
      .replace('{n}', String(reviews.length))
      .replace('{nounOwners}', reviews.length === 1 ? 'owner' : 'owners')
  : h.headingWithoutReviews;

const businessId = `${site.url}/#business`;
// Google's review-snippet guidelines forbid Review / AggregateRating markup for
// ratings sourced from a third-party platform. These reviews are reposted from the
// Google Business profile, so we DISPLAY them as social proof but do NOT emit review
// structured data. That would risk a "spammy structured markup" manual action. Flip
// to true only if reviews are ever collected first-party; visible content (the cards,
// the star strip and the "x.x from N reviews" line) is unaffected either way.
const EMIT_REVIEW_SCHEMA = false;
const reviewSchema = (EMIT_REVIEW_SCHEMA && hasReviews) ? buildReviewSchema({
  url: `${site.url}/reviews/`,
  businessId,
  businessName: site.name,
  reviews: sorted,
}) : null;
const aggregateSchema = (EMIT_REVIEW_SCHEMA && hasReviews) ? buildAggregateRatingSchema({ businessId, ratings }) : null;
const crumbs = [
  { name: "Home", url: `${site.url}/` },
  { name: "Reviews", url: `${site.url}/reviews/` },
];
const breadcrumbSchema = buildBreadcrumbSchema(crumbs);
---
<Layout title={m.title} description={m.description} ogImage={m.ogImage} schema={[reviewSchema, aggregateSchema, breadcrumbSchema]}>

  <PageHero eyebrow={h.eyebrow} heading={heading} body={h.body} align="left" photo={h.photo} photoAlt={h.photoAlt}>
    <Breadcrumbs crumbs={crumbs} slot="before-eyebrow" />
    <a href={h.ctaPrimaryHref} class="btn-primary">{h.ctaPrimary}</a>
    <a href={h.ctaSecondaryHref} class="btn-secondary">{h.ctaSecondary}</a>
  </PageHero>

  <Section bg="white">
    <div class="container-wide">
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {sorted.map((r, i) => (
          <Reveal delay={i * 60}>
            <ReviewCard review={r} />
          </Reveal>
        ))}
      </div>
      {site.googleReviewsUrl && (
        <div class="mt-10 text-center">
          <a href={site.googleReviewsUrl} target="_blank" rel="noopener" class="btn-secondary">Read our reviews on Google</a>
        </div>
      )}
    </div>
  </Section>

  <ContactCTASection heading={cta.heading} body={cta.body} />
</Layout>
