---
import site from '../data/site.json';
const waText = encodeURIComponent("Hi Keith, I'd like to book a groom for my dog.");
const waUrl = `https://wa.me/${site.whatsappIntl}?text=${waText}`;
---
<div id="wa-root" class="fixed bottom-5 right-5 z-50 print:hidden">
  <button id="wa-toggle" class="group flex items-center justify-center w-14 h-14 md:w-16 md:h-16 rounded-full bg-whatsapp shadow-lg shadow-whatsapp/30 hover:scale-105 transition-transform" aria-label="Chat with Keith on WhatsApp" aria-expanded="false" aria-controls="wa-card">
    <svg class="w-7 h-7 md:w-8 md:h-8 text-white" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.946C.157 5.335 5.495 0 12.05 0a11.815 11.815 0 018.413 3.488 11.819 11.819 0 013.48 8.414c-.003 6.557-5.34 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 001.51 5.26l.241.383-1.005 3.667 3.743-.982.001-.027zM17.367 14.43c-.074-.124-.272-.198-.57-.347-.296-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.481-1.761-1.654-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.297-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.611-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01a1.097 1.097 0 00-.793.371c-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.076 4.487 2.487 1.075 2.992.86 3.532.811.54-.05 1.758-.718 2.005-1.412.247-.694.247-1.289.173-1.413z"/>
    </svg>
  </button>

  <div id="wa-card" class="hidden absolute bottom-20 right-0 w-80 max-w-[calc(100vw-2.5rem)] bg-white rounded-2xl shadow-2xl shadow-ink-900/20 ring-1 ring-ink-100 overflow-hidden animate-slide-up">
    <div class="bg-whatsapp text-white px-5 py-4 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-full bg-white flex items-center justify-center">
          <img src="/assets/logo.png" alt="" class="w-7 h-7" />
        </div>
        <div>
          <p class="font-semibold leading-tight">Keith's K9 Care</p>
          <p class="text-xs text-white/80">Typically replies within an hour</p>
        </div>
      </div>
      <button id="wa-close" class="text-white/80 hover:text-white" aria-label="Close">
        <svg aria-hidden="true" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <div class="p-5 space-y-3">
      <div class="bg-ink-50 rounded-xl rounded-tl-sm px-4 py-3 text-sm text-ink-800">
        Hi! Have a question or want to book your dog in for a groom? Send Keith a quick WhatsApp.
      </div>
      <a href={waUrl} target="_blank" rel="noopener" class="block w-full text-center rounded-full bg-whatsapp hover:bg-green-600 text-white font-semibold py-3 transition">
        Start chat on WhatsApp
      </a>
      <p class="text-xs text-ink-500 text-center">Or call <a href={`tel:${site.phoneIntl}`} class="text-teal-700 font-semibold">{site.phone}</a></p>
    </div>
  </div>
</div>

<script>
  const root = document.getElementById('wa-root');
  const toggle = document.getElementById('wa-toggle');
  const card = document.getElementById('wa-card');
  const close = document.getElementById('wa-close');

  if (sessionStorage.getItem('wa-dismissed') === '1') {
    root?.classList.add('hidden');
  }

  const open = () => {
    card?.classList.remove('hidden');
    toggle?.setAttribute('aria-expanded', 'true');
  };
  const hide = () => {
    card?.classList.add('hidden');
    toggle?.setAttribute('aria-expanded', 'false');
  };

  toggle?.addEventListener('click', () => {
    card?.classList.contains('hidden') ? open() : hide();
  });
  close?.addEventListener('click', () => {
    hide();
    // Soft dismiss: don't pop again this session
    sessionStorage.setItem('wa-dismissed', '1');
    setTimeout(() => root?.classList.add('hidden'), 200);
  });

  // Auto-open after 12s on first homepage visit only
  if (window.location.pathname === '/' && !sessionStorage.getItem('wa-seen')) {
    setTimeout(() => {
      if (!sessionStorage.getItem('wa-dismissed')) open();
      sessionStorage.setItem('wa-seen', '1');
    }, 12000);
  }
</script>
