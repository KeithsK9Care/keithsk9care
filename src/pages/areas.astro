---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';
import { areas } from '../lib/content';
import PageHero from '../components/PageHero.astro';
import Reveal from '../components/Reveal.astro';
import AreaPill from '../components/AreaPill.astro';
import ReviewStrip from '../components/ReviewStrip.astro';

const title = "Dog grooming areas we cover — Wakefield WF4 | Keith's K9 Care";
const description = `Keith's K9 Care serves ${areas.length} villages around Hall Green, near Newmillerdam, Wakefield WF4 — from Crigglestone and Sandal to Horbury, Haigh and Notton.`;
---
<Layout title={title} description={description} ogImage="/assets/photos/golden-puppy-woodland-3.jpg">
  <PageHero
    eyebrow="Areas we cover"
    heading="Local to Hall Green, serving the wider Wakefield area."
    body={`Most of our customers live within a 5-minute drive of the salon in Hall Green — but we groom dogs from right across the Wakefield WF4 villages and into north Barnsley. Pick your area below for local details, drive times and the questions we get asked most.`}
  />

  <ReviewStrip />

  <section class="section">
    <div class="container-tight">
      <Reveal class="flex flex-wrap gap-2">
        {areas.map(a => <AreaPill area={a} />)}
      </Reveal>

      <Reveal delay={200} class="mt-10 text-center">
        <a href="/book/" class="btn-primary">Get in touch</a>
      </Reveal>
    </div>
  </section>

  <!-- COVERAGE OVERVIEW -->
  <section class="section bg-teal-50/50 pt-0">
    <div class="container-tight space-y-5 text-lg text-ink-700 leading-relaxed">
      <p>We're based on Castle Meadows in Hall Green — the WF4 village just south of Newmillerdam Country Park — and most of the dogs we groom come from within a five-minute drive: Crigglestone, Chapelthorpe, Newmillerdam, Sandal and the surrounding WF4 and WF2 streets. We also groom plenty of dogs from a little further out, from Horbury and Calder Grove across to West Bretton, Notton, Woolley and into Haigh on the Barnsley side.</p>
      <p>Wherever you are, the offer is the same: a calm, one-dog-at-a-time groom in a quiet home salon, published prices confirmed before any work starts, and easy parking right outside — no city-centre traffic and no hunting for a space. Pick your area above for local drive times, landmarks and the questions we get asked most.</p>
    </div>
  </section>
</Layout>
