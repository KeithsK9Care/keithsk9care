---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';
import services from '../data/services.json';
import SectionIntro from '../components/SectionIntro.astro';
import PageHero from '../components/PageHero.astro';
import Reveal from '../components/Reveal.astro';

const title = "Book a groom | Keith's K9 Care";
const description = `Book Keith's K9 Care — call ${site.phone}, WhatsApp, or send the booking form. Home grooming salon in ${site.address.locality}, ${site.address.postcode}.`;
---
<Layout title={title} description={description} noindex={true} hideWhatsApp={true} ogImage="/assets/photos/keith-with-chihuahua.jpg">

  <PageHero
    eyebrow="Book a groom"
    heading="Get in touch with Keith."
    body="Keith likes a quick chat about your dog before the first booking — coat type, age, any nerves — so he can pick the right slot. Use the form below, or jump straight to call / WhatsApp."
  />

  <!-- QUICK CONTACT ROW -->
  <section class="pb-4">
    <div class="container-tight grid sm:grid-cols-3 gap-3">
      <Reveal>
        <a href={`tel:${site.phoneIntl}`} class="block rounded-2xl bg-white ring-1 ring-ink-100 p-5 hover:ring-coral-300 hover:shadow-md transition">
          <p class="text-xs font-semibold uppercase tracking-wider text-coral-700">Call</p>
          <p class="mt-1 text-lg font-display font-semibold text-teal-700">{site.phone}</p>
          <p class="mt-0.5 text-xs text-ink-500">Straight through to Keith.</p>
        </a>
      </Reveal>
      <Reveal delay={80}>
        <a href={`https://wa.me/${site.whatsappIntl}?text=Hi%20Keith%2C%20I%27d%20like%20to%20book%20a%20groom%20for%20my%20dog.`} target="_blank" rel="noopener" class="block rounded-2xl bg-whatsapp text-white p-5 hover:bg-green-600 transition">
          <p class="text-xs font-semibold uppercase tracking-wider text-white/80">WhatsApp</p>
          <p class="mt-1 text-lg font-display font-semibold">Message Keith</p>
          <p class="mt-0.5 text-xs text-white/90">Usually a reply within the hour.</p>
        </a>
      </Reveal>
      <Reveal delay={160}>
        <a href={`mailto:${site.email}`} class="block rounded-2xl bg-white ring-1 ring-ink-100 p-5 hover:ring-coral-300 hover:shadow-md transition">
          <p class="text-xs font-semibold uppercase tracking-wider text-coral-700">Email</p>
          <p class="mt-1 text-base font-display font-semibold text-teal-700 break-all">{site.email}</p>
          <p class="mt-0.5 text-xs text-ink-500">For non-urgent enquiries.</p>
        </a>
      </Reveal>
    </div>
  </section>

  <!-- FORM -->
  <section class="section">
    <div class="container-tight">
      <Reveal class="mb-8">
        <SectionIntro
          eyebrow="Or use the form"
          heading="Tell Keith about your dog."
          description="The more we know up front — breed, coat, age, any nerves — the better we can prep the slot. Keith reads every message and replies personally."
        />
      </Reveal>

      <Reveal delay={100}>
        <form
          method="POST"
          action="/api/book"
          class="rounded-3xl bg-white ring-1 ring-ink-100 p-6 md:p-8 space-y-5"
        >
          <!-- Honeypot — hidden from real users, bots tend to fill -->
          <div class="hidden" aria-hidden="true">
            <label>Company (leave blank): <input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
          </div>

          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label for="name" class="block text-sm font-semibold text-ink-800">Your name <span class="text-coral-500">*</span></label>
              <input id="name" name="name" type="text" required class="form-input mt-1" placeholder="Jane Smith" autocomplete="name" />
            </div>
            <div>
              <label for="phone" class="block text-sm font-semibold text-ink-800">Phone</label>
              <input id="phone" name="phone" type="tel" class="form-input mt-1" placeholder="07…" autocomplete="tel" />
            </div>
          </div>

          <div>
            <label for="email" class="block text-sm font-semibold text-ink-800">Email <span class="text-coral-500">*</span></label>
            <input id="email" name="email" type="email" required class="form-input mt-1" placeholder="you@example.com" autocomplete="email" />
          </div>

          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label for="dogName" class="block text-sm font-semibold text-ink-800">Your dog's name</label>
              <input id="dogName" name="dogName" type="text" class="form-input mt-1" placeholder="Ringo" />
            </div>
            <div>
              <label for="breed" class="block text-sm font-semibold text-ink-800">Breed / coat type</label>
              <input id="breed" name="breed" type="text" class="form-input mt-1" placeholder="Cockapoo, mini schnauzer…" />
            </div>
          </div>

          <div>
            <label for="service" class="block text-sm font-semibold text-ink-800">Service you're interested in</label>
            <select id="service" name="service" class="form-input mt-1">
              <option value="">— Not sure / Keith to advise —</option>
              {services.map((s) => <option value={s.name}>{s.name}</option>)}
            </select>
          </div>

          <div>
            <label for="message" class="block text-sm font-semibold text-ink-800">Message <span class="text-coral-500">*</span></label>
            <textarea id="message" name="message" rows="5" required class="form-input mt-1" placeholder="A little about your dog — age, last groom, anything Keith should know about behaviour or coat."></textarea>
          </div>

          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-2">
            <p class="text-xs text-ink-500">By submitting, you agree we can use your details to reply about your booking.</p>
            <button type="submit" class="btn-primary justify-center">Send to Keith</button>
          </div>
        </form>
      </Reveal>
    </div>
  </section>

  <!-- LOCATION -->
  <section class="section bg-ink-50/60">
    <div class="container-tight">
      <Reveal>
        <SectionIntro
          eyebrow="Find us"
          heading="A short drive from anywhere in WF4."
        />
      </Reveal>
      <Reveal class="mt-8 grid md:grid-cols-2 gap-5" delay={100}>
        <div class="rounded-2xl bg-white ring-1 ring-ink-100 p-6">
          <p class="text-xs font-semibold uppercase tracking-wider text-coral-500 mb-3">Address</p>
          <address class="not-italic text-ink-800 text-lg leading-relaxed">
            {site.address.street}<br/>
            {site.address.locality}, {site.address.region}<br/>
            {site.address.postcode}
          </address>
          <a href={`https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(site.address.street + ', ' + site.address.postcode)}`} target="_blank" rel="noopener" class="btn-ghost mt-4">
            Get directions
            <svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
          <p class="mt-4 text-sm text-ink-600">A short stroll from Newmillerdam Country Park.</p>
        </div>

        <div class="rounded-2xl bg-white ring-1 ring-ink-100 p-6">
          <p class="text-xs font-semibold uppercase tracking-wider text-coral-500 mb-3">Opening hours</p>
          <ul class="text-ink-800 space-y-1">
            {site.hours.map(h => (
              <li class="flex justify-between gap-4"><span class="font-semibold">{h.day}</span><span>{h.open}–{h.close}</span></li>
            ))}
          </ul>
          <p class="text-sm text-ink-600 mt-3">{site.hoursNote}</p>
        </div>
      </Reveal>
    </div>
  </section>
</Layout>

<style>
  .form-input {
    @apply block w-full rounded-xl border-0 ring-1 ring-ink-200 px-4 py-2.5 text-ink-900 placeholder:text-ink-400 focus:outline-none focus:ring-2 focus:ring-teal-500 transition;
    background: white;
  }
  textarea.form-input { @apply leading-relaxed; }
  select.form-input { appearance: none; background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='12' height='8' viewBox='0 0 12 8'><path fill='%2308667a' d='M6 8L0 0h12z'/></svg>"); background-repeat: no-repeat; background-position: right 1rem center; padding-right: 2.5rem; }
</style>
