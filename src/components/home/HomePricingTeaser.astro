---
import PriceTable from '../PriceTable.astro';
import Reveal from '../Reveal.astro';
import SectionIntro from '../SectionIntro.astro';
---
<section id="pricing" class="section">
  <div class="container-wide">
    <Reveal>
      <SectionIntro
        eyebrow="Pricing"
        heading="No surprises. Prices on the page."
        description="Most local groomers won't tell you what they charge until you ring. We will. Final price varies a little by breed, coat and behaviour — and we always confirm before we start."
      />
      <a href="/pricing/" class="btn-ghost mt-5">
        See full price guide
        <svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
    </Reveal>

    <Reveal class="mt-10" delay={120}>
      <PriceTable>
        <div slot="surcharges" class="bg-teal-50 px-6 md:px-7 py-4 text-xs text-ink-700">
          Surcharges where applicable — matted coats from £10 (severe assessed on the day) · nervous, anxious or reactive dogs +£10–£20 · extra time may apply for heavy coats or long gaps between grooms.
        </div>
      </PriceTable>
    </Reveal>
  </div>
</section>
