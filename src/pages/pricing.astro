---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';
import services from '../data/services.json';

const title = "Dog grooming prices | Keith's K9 Care";
const description = `Full published price guide for Keith's K9 Care dog grooming — no surprises. Home salon in ${site.address.locality}, ${site.address.region} ${site.address.postcode}.`;
---
<Layout title={title} description={description} noindex={true}>

  <section class="section">
    <div class="container-wide">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold uppercase tracking-wider text-coral-500">Pricing</p>
        <h1 class="mt-3 text-4xl md:text-5xl leading-tight">No surprises. Prices on the page.</h1>
        <p class="mt-5 text-lg text-ink-700 leading-relaxed">
          Most local groomers won't tell you what they charge until you ring. We will. Prices start from the figures shown and may vary a little by breed, coat condition and behaviour — and Keith will always confirm the price with you before he starts.
        </p>
      </div>

      <div class="mt-12 rounded-3xl ring-1 ring-ink-100 bg-white overflow-hidden">
        {services.map((s, i) => (
          <div class={`p-6 md:p-8 ${i > 0 ? 'border-t border-ink-100' : ''}`}>
            <div class="flex flex-wrap items-baseline justify-between gap-3">
              <h2 class="text-xl md:text-2xl font-display font-semibold text-ink-900">{s.name}</h2>
              <span class="text-sm text-ink-500">{s.duration}</span>
            </div>
            <p class="mt-2 text-ink-700 leading-relaxed max-w-2xl">{s.summary}</p>
            <ul class="mt-4 grid sm:grid-cols-3 gap-2 text-sm">
              {s.tiers.map(t => (
                <li class="flex justify-between gap-3 rounded-lg bg-ink-50 px-3 py-2">
                  <span class="text-ink-700">{t.label}</span>
                  <span class="font-semibold text-teal-700">from £{t.from}</span>
                </li>
              ))}
            </ul>
            {s.includes && (
              <p class="mt-3 text-xs text-ink-500">Includes: {s.includes.join(' · ')}</p>
            )}
          </div>
        ))}
        <div class="bg-teal-50 px-6 md:px-8 py-5 text-sm text-ink-700 space-y-1">
          <p><strong>Surcharges where applicable:</strong></p>
          <p>· Matted coats from £10 (severe matting assessed on the day — Keith will talk it through with you first).</p>
          <p>· Nervous, anxious or reactive dogs: £10–£20 additional for the extra time it can take.</p>
          <p>· Extra time may apply for heavy coats or long gaps between grooms.</p>
        </div>
      </div>

      <!-- Contact CTA -->
      <div class="mt-14 rounded-3xl bg-gradient-to-br from-teal-700 to-teal-800 p-8 md:p-12 text-white text-center">
        <h2 class="text-2xl md:text-3xl text-white">Questions about your dog's groom?</h2>
        <p class="mt-3 text-teal-100 max-w-xl mx-auto">Give Keith a call or message — he's always happy to talk through what your dog needs before booking.</p>
        <div class="mt-6 flex flex-col sm:flex-row gap-3 justify-center">
          <a href={`tel:${site.phoneIntl}`} class="inline-flex items-center justify-center gap-2 rounded-full bg-white text-teal-700 font-semibold px-6 py-3 hover:bg-coral-50 transition">{site.phone}</a>
          <a href={`https://wa.me/${site.whatsappIntl}`} target="_blank" rel="noopener" class="inline-flex items-center justify-center gap-2 rounded-full bg-whatsapp text-white font-semibold px-6 py-3 hover:bg-green-600 transition">WhatsApp Keith</a>
        </div>
      </div>

      <p class="mt-10 text-sm text-ink-500">
        <a href="/" class="text-teal-700 font-semibold hover:text-coral-500">← Back to home</a>
      </p>
    </div>
  </section>

</Layout>
