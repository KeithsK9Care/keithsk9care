---
import StarRating from './StarRating.astro';
export interface Props {
  review: {
    author: string;
    location?: string;
    dog?: string;
    service?: string;
    rating: number;
    body: string;
    date?: string;
    sourceUrl?: string;
  };
  compact?: boolean;
}
const { review: r, compact = false } = Astro.props;
const meta = [r.dog, r.location, r.service].filter(Boolean).join(' · ');
// In the sitewide reel (compact) render only a short EXCERPT. The full review text
// lives once, on /reviews/. Repeating every full review on every page would be a
// duplicate / thin-content footprint (the reel ships on ~27 pages). Full-size cards
// (the /reviews/ page) always render the whole body.
const EXCERPT = 150;
const text = compact && r.body.length > EXCERPT + 10
  ? r.body.slice(0, EXCERPT).replace(/\s+\S*$/, '').trimEnd() + '…'
  : r.body;
---
<article class="rounded-2xl bg-white ring-1 ring-ink-100 p-6 h-full flex flex-col">
  <StarRating rating={r.rating} class="gap-1 mb-2" />
  <blockquote class:list={['text-ink-800 leading-relaxed flex-1', compact ? 'text-sm line-clamp-4' : '']}>
    "{text}"
  </blockquote>
  <footer class="mt-4 pt-4 border-t border-ink-100 text-sm">
    <p class="font-display font-semibold text-ink-900">{r.author}</p>
    <p class="text-xs text-ink-600 mt-0.5">{meta}</p>
    {r.sourceUrl && (
      <a href={r.sourceUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-1 mt-2 text-xs font-semibold text-teal-700 hover:text-coral-700">
        View on Google
        <svg aria-hidden="true" class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H9M17 7v8"/></svg>
      </a>
    )}
  </footer>
</article>
