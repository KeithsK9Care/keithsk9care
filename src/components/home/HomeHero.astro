---
import site from '../../data/site.json';
import copy from '../../data/copy/home.json';
const h = copy.hero;
const imgs = copy.images;
import { reviews } from '../../lib/content';
import Picture from '../Picture.astro';
import StarRating from '../StarRating.astro';

const reviewCount = reviews.length;
const avgRating = reviewCount > 0 ? (reviews.reduce((a: number, r: any) => a + r.rating, 0) / reviewCount).toFixed(1) : null;

// Faint paw-print trail in the hero background — draws itself on scroll.
const pawShapes = `<ellipse pathLength="1" cx="32" cy="46" rx="13" ry="10.5"/><ellipse pathLength="1" cx="15" cy="31" rx="5" ry="7"/><ellipse pathLength="1" cx="26" cy="22" rx="5" ry="7.5"/><ellipse pathLength="1" cx="40" cy="22" rx="5" ry="7.5"/><ellipse pathLength="1" cx="50" cy="31" rx="5" ry="7"/>`;
const paws = [
  { cls: 'paw-1', style: 'left:4%;top:74%;width:46px;transform:rotate(-14deg)' },
  { cls: 'paw-2', style: 'left:13%;top:85%;width:42px;transform:rotate(10deg)' },
  { cls: 'paw-3', style: 'left:23%;top:76%;width:48px;transform:rotate(-8deg)' },
  { cls: 'paw-4', style: 'left:33%;top:87%;width:42px;transform:rotate(13deg)' },
  { cls: 'paw-5', style: 'left:43%;top:77%;width:46px;transform:rotate(-6deg)' },
  { cls: 'paw-6', style: 'left:53%;top:86%;width:44px;transform:rotate(11deg)' },
  { cls: 'paw-7', style: 'left:63%;top:78%;width:48px;transform:rotate(-5deg)' },
];
---
<section class="relative overflow-hidden bg-gradient-to-b from-teal-50 via-white to-teal-50 border-b border-teal-100/80">
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute -top-24 -right-24 w-96 h-96 bg-coral-100 rounded-full blur-3xl opacity-50"></div>
    <div class="absolute top-32 -left-24 w-96 h-96 bg-teal-100 rounded-full blur-3xl opacity-40"></div>
  </div>

  <!-- Faint paw-print trail — draws itself on scroll -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
    {paws.map((p) => (
      <svg class={`paw ${p.cls} absolute text-coral-300 opacity-50`} style={p.style} viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" set:html={pawShapes} />
    ))}
  </div>

  <div class="container-wide relative pt-12 pb-20 md:pt-20 md:pb-28 grid md:grid-cols-2 gap-12 items-center">
    <div>
      <div class="flex flex-wrap items-center gap-2">
          <span class="inline-flex items-center gap-2 rounded-full bg-white shadow-sm ring-1 ring-ink-100 px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-teal-700">
            <span class="w-2 h-2 rounded-full bg-coral-500"></span>
            {h.locationPill}
          </span>
          {avgRating && (
            <a href="/reviews/" class="inline-flex items-center gap-1.5 rounded-full bg-white shadow-sm ring-1 ring-ink-100 px-3 py-1.5 text-xs font-semibold text-ink-800 hover:ring-coral-300 transition">
              <span class="text-coral-500 leading-none" aria-hidden="true">★★★★★</span>
              <span>{avgRating}</span>
              <span class="text-ink-600">· {reviewCount} {reviewCount === 1 ? 'review' : 'reviews'}</span>
            </a>
          )}
        </div>
      <h1 class="mt-6 text-4xl md:text-5xl lg:text-6xl leading-[1.05]" set:html={h.headingHtml}></h1>
      <p class="mt-6 text-lg md:text-xl text-ink-700 leading-relaxed max-w-xl">
        {h.bodyPara1}
      </p>
      <p class="mt-4 text-base md:text-lg text-ink-700 leading-relaxed max-w-xl">
        {h.bodyPara2}
      </p>
      <div class="mt-8 flex flex-col sm:flex-row gap-3">
        <a href={h.ctaPrimaryHref} class="btn-primary">{h.ctaPrimary}</a>
        <a href={h.ctaSecondaryHref} class="btn-secondary">{h.ctaSecondary}</a>
      </div>

      <ul class="mt-9 flex flex-wrap gap-2 max-w-xl">
        {site.trustPoints.map((p, i) => (
          <li class="hero-pill-in inline-flex items-center gap-1.5 rounded-full bg-white shadow-sm ring-1 ring-ink-100 px-3.5 py-1.5 text-sm font-semibold text-ink-800" style={`animation-delay:${i * 70}ms`}>
            <svg aria-hidden="true" class="w-4 h-4 text-coral-500 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
            {p}
          </li>
        ))}
      </ul>
    </div>

    <div class="relative">
      <div class="relative rounded-3xl overflow-hidden ring-1 ring-ink-100 shadow-2xl shadow-teal-900/10 aspect-[4/5]">
        <Picture src={imgs.heroPhoto} size={800} alt={imgs.heroPhotoAlt} width={800} height={1000} priority class="w-full h-full object-cover kenburns" />
      </div>
      <div class="absolute -bottom-6 -left-6 hidden md:block bg-white rounded-2xl shadow-xl ring-1 ring-ink-100 px-5 py-4 max-w-[200px]">
        <StarRating decorative class="gap-2 mb-1" />
        <p class="text-sm font-semibold text-ink-900 leading-tight">{h.ipetBadge}</p>
      </div>
    </div>
  </div>
</section>
