---
import Layout from '../../layouts/Layout.astro';
import site from '../../data/site.json';
import { stories } from '../../lib/content';
import copy from '../../data/copy/groom-stories.json';
import PageHero from '../../components/PageHero.astro';
import Picture from '../../components/Picture.astro';
import Reveal from '../../components/Reveal.astro';
import ContactCTACard from '../../components/ContactCTACard.astro';
import { buildBreadcrumbSchema } from '../../lib/schemas';

const m = copy.meta;
const h = copy.hero;
const cta = copy.contactCta;

const sorted = [...stories].sort((a, b) => (b.date || '').localeCompare(a.date || ''));

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: "Home", url: `${site.url}/` },
  { name: "Groom Stories", url: `${site.url}/groom-stories/` },
]);
---
<Layout title={m.title} description={m.description} ogImage={m.ogImage}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <PageHero eyebrow={h.eyebrow} heading={h.heading} body={h.body}>
    <a href={h.ctaPrimaryHref} class="btn-primary">{h.ctaPrimary}</a>
  </PageHero>

  <section class="section">
    <div class="container-wide">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {sorted.map((s, i) => (
          <Reveal delay={i * 70}>
            <a href={`/groom-stories/${s.slug}/`} class="group block rounded-2xl bg-white ring-1 ring-ink-100 hover:ring-coral-300 hover:shadow-lg hover:-translate-y-0.5 transition overflow-hidden h-full">
              <div class="relative aspect-[4/3]">
                {s.afterPhoto && <Picture src={s.afterPhoto} size={800} alt={`${s.dog} after a ${s.service} at Keith's K9 Care`} width={800} height={600} />}
              </div>
              <div class="p-5">
                <p class="text-xs font-semibold uppercase tracking-wider text-coral-700">{s.service}</p>
                <h2 class="mt-2 text-xl font-display font-semibold text-ink-900 group-hover:text-coral-700 transition">{s.title || `${s.dog} — ${s.breed}`}</h2>
                <p class="mt-2 text-xs text-ink-600">{s.dog} · {s.breed}</p>
                <p class="mt-2 text-sm text-ink-600 leading-relaxed">{s.description || s.summary}</p>
                <p class="mt-3 text-xs text-ink-600">{s.area}</p>
              </div>
            </a>
          </Reveal>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-wide">
      <Reveal>
        <ContactCTACard heading={cta.heading} body={cta.body} />
      </Reveal>
    </div>
  </section>
</Layout>
