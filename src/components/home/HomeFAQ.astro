---
import FAQItem from '../FAQItem.astro';
export interface Props {
  faqs: { q: string; a: string }[];
}
const { faqs } = Astro.props;
---
<section class="section bg-teal-50/60">
  <div class="container-tight">
    <div class="max-w-2xl mb-10">
      <p class="text-sm font-semibold uppercase tracking-wider text-coral-500">Common questions</p>
      <h2 class="mt-3 text-3xl md:text-4xl">Before your dog's first visit.</h2>
    </div>

    <div class="space-y-3">
      {faqs.map((f, i) => <FAQItem faq={f} open={i === 0} />)}
    </div>

    <p class="mt-8 text-sm text-ink-600">
      More on the <a href="/faq/" class="text-teal-700 font-semibold hover:text-coral-500">full FAQ page</a>.
    </p>
  </div>
</section>
