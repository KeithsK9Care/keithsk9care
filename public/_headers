# Cache static assets aggressively (filenames are content-hashed by Astro).
# Security headers come from the /* block below; they cascade onto these paths,
# so they're not repeated here (avoids the duplicated X-Content-Type-Options).
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Security headers on every response
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), interest-cohort=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  # Report-Only for now: it logs violations to the browser console but never blocks.
  # Tuned for the PUBLIC site (self + Formspree + Cloudflare Web Analytics + inline).
  # To ENFORCE: rename the header to "Content-Security-Policy" AND add a Cloudflare
  # Transform Rule that overrides CSP for /admin/* with the Sveltia CMS sources
  # (script-src https://unpkg.com; connect-src https://api.github.com https://unpkg.com
  # https://*.githubusercontent.com; worker-src blob:), or the CMS will break.
  Content-Security-Policy-Report-Only: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; connect-src 'self' https://formspree.io https://cloudflareinsights.com; form-action 'self' https://formspree.io; upgrade-insecure-requests

# HTML can be revalidated more often (Cloudflare honours this for non-asset routes)
/
  Cache-Control: public, max-age=300, must-revalidate
