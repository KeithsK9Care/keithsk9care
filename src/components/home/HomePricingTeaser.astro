---
import site from '../../data/site.json';
import PriceTable from '../PriceTable.astro';
import Reveal from '../Reveal.astro';
import SectionIntro from '../SectionIntro.astro';
import copy from '../../data/copy/home.json';

const c = copy.pricingTeaser;
---
<section id="pricing" class="section bg-ink-50/60">
  <div class="container-wide">
    <Reveal>
      <SectionIntro eyebrow={c.eyebrow} heading={c.heading} description={c.description} />
      <a href={c.linkHref} class="btn-ghost mt-5">
        {c.linkText}
        <svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
    </Reveal>
    <Reveal class="mt-10" delay={120}>
      <PriceTable>
        <div slot="surcharges" class="bg-teal-50 px-6 md:px-7 py-4 text-xs text-ink-700">
          {site.surchargesNote}
        </div>
      </PriceTable>
    </Reveal>
  </div>
</section>
