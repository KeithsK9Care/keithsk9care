---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';
import copy from '../data/copy/about.json';
import Picture from '../components/Picture.astro';
import SectionIntro from '../components/SectionIntro.astro';
import Reveal from '../components/Reveal.astro';
import ContactCTASection from '../components/ContactCTASection.astro';
import InfoCard from '../components/InfoCard.astro';
import PhotoGrid from '../components/PhotoGrid.astro';
import { buildPersonSchema, buildBreadcrumbSchema } from '../lib/schemas';
import ReviewStrip from '../components/ReviewStrip.astro';

const m = copy.meta;
const h = copy.hero;
const story = copy.story;
const why = copy.whyKeith;
const qual = copy.qualifications;
const salon = copy.salon;
const phil = copy.philosophy;
const cta = copy.contactCta;

// Decorative icons keyed positionally to whyKeith.pillars
const PILLAR_ICONS = [
  `<svg aria-hidden="true" class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`,
  `<svg aria-hidden="true" class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>`,
  `<svg aria-hidden="true" class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24"><circle cx="8" cy="6" r="2.2"/><circle cx="16" cy="6" r="2.2"/><circle cx="5" cy="11" r="1.8"/><circle cx="19" cy="11" r="1.8"/><path d="M12 11c-3 0-6 2.5-6 5.5C6 19 8 21 12 21s6-2 6-4.5c0-3-3-5.5-6-5.5z"/></svg>`,
  `<svg aria-hidden="true" class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-2.21 0-4-1.79-4-4 0-1.86 1.275-3.426 3-3.874M12 6V4m0 16v-2"/></svg>`,
  `<svg aria-hidden="true" class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24"><path d="M11.645 20.91a.75.75 0 00.71 0c3.78-2.082 8.395-6.04 8.395-11.16 0-3.073-2.488-5.5-5.5-5.5-1.886 0-3.55.92-4.5 2.337C9.8 5.17 8.136 4.25 6.25 4.25c-3.012 0-5.5 2.427-5.5 5.5 0 5.12 4.615 9.078 8.395 11.16z"/></svg>`,
  `<svg aria-hidden="true" class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0L6.343 16.657A8 8 0 1117.657 16.657z"/><circle cx="12" cy="11" r="3" stroke-width="1.6"/></svg>`,
];

const personSchema = buildPersonSchema({
  url: `${site.url}/about/`,
  name: site.owner,
  jobTitle: "IPET-qualified dog groomer",
  alumniOf: "Mrs B's Grooming Academy, Leeds",
  worksFor: site.name,
  worksForUrl: site.url,
  image: `${site.url}/assets/photos/${h.photo}-800.jpg`,
  knowsAbout: ["Dog grooming", "Puppy grooming", "Hand stripping", "De-matting", "Nervous dog handling", "Doodle and cockapoo grooming"],
});

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: "Home", url: `${site.url}/` },
  { name: "About Keith", url: `${site.url}/about/` },
]);
---
<Layout title={m.title} description={m.description} ogImage={m.ogImage} schema={[personSchema, breadcrumbSchema]}>

  <!-- HERO -->
  <section class="section bg-gradient-to-b from-teal-50 via-white to-white">
    <div class="container-tight grid md:grid-cols-5 gap-10 md:gap-14 items-center">
      <Reveal class="md:col-span-2">
        <div class="relative rounded-3xl overflow-hidden ring-1 ring-ink-100 shadow-xl shadow-teal-900/10 aspect-[4/5]">
          <Picture src={h.photo} size={800} alt={h.photoAlt} width={800} height={1000} priority />
        </div>
      </Reveal>
      <Reveal class="md:col-span-3" delay={120}>
        <p class="text-sm font-semibold uppercase tracking-wider text-coral-700">{h.eyebrow}</p>
        <h1 class="mt-3 text-4xl md:text-5xl lg:text-6xl leading-[1.05]">{h.heading}</h1>
        <p class="mt-6 text-lg md:text-xl text-ink-700 leading-relaxed max-w-xl">{h.body}</p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href={h.ctaPrimaryHref} class="btn-primary">{h.ctaPrimary}</a>
          <a href={h.ctaSecondaryHref} class="btn-secondary">{h.ctaSecondary}</a>
        </div>
      </Reveal>
    </div>
  </section>

  <ReviewStrip />

  <!-- STORY -->
  <section class="section">
    <div class="container-tight">
      <Reveal>
        <SectionIntro eyebrow={story.eyebrow} heading={story.heading} />
      </Reveal>
      <Reveal class="mt-8 space-y-5 text-lg text-ink-700 leading-relaxed max-w-2xl" delay={120}>
        {story.paragraphs.map((p: string) => (<p>{p}</p>))}
      </Reveal>
    </div>
  </section>

  <!-- WHY KEITH — trust-pillar grid -->
  <section class="section bg-teal-50/60">
    <div class="container-wide">
      <Reveal class="mb-10">
        <SectionIntro eyebrow={why.eyebrow} heading={why.heading} description={why.description} />
      </Reveal>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {why.pillars.map((p: any, i: number) => (
          <Reveal delay={i * 70}>
            <div class="rounded-2xl bg-white ring-1 ring-ink-100 p-6 h-full">
              <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-coral-50 text-coral-700 mb-4" set:html={PILLAR_ICONS[i] || ''}></div>
              <p class="text-xs font-semibold uppercase tracking-wider text-coral-700">{p.eyebrow}</p>
              <h3 class="mt-1 text-xl">{p.heading}</h3>
              <p class="mt-3 text-ink-700 leading-relaxed text-sm" set:html={p.body}></p>
            </div>
          </Reveal>
        ))}
      </div>
    </div>
  </section>

  <!-- QUALIFICATIONS -->
  <section class="section bg-teal-50/60">
    <div class="container-wide">
      <Reveal>
        <SectionIntro eyebrow={qual.eyebrow} heading={qual.heading} />
      </Reveal>
      <div class="mt-10 grid md:grid-cols-2 gap-6">
        <Reveal>
          <InfoCard eyebrow={qual.training.eyebrow} heading={qual.training.heading}>
            <Fragment set:html={qual.training.body} />
          </InfoCard>
        </Reveal>
        <Reveal delay={100}>
          <InfoCard eyebrow={qual.insurance.eyebrow} heading={qual.insurance.heading}>
            <Fragment set:html={qual.insurance.body} />
          </InfoCard>
        </Reveal>
      </div>
    </div>
  </section>

  <!-- THE SALON -->
  <section class="section">
    <div class="container-wide">
      <Reveal>
        <SectionIntro eyebrow={salon.eyebrow} heading={salon.heading} description={salon.description} />
      </Reveal>
      <div class="mt-10">
        <PhotoGrid photos={salon.photos} cols={3} />
      </div>
    </div>
  </section>

  <!-- PHILOSOPHY -->
  <section class="section bg-ink-50/60">
    <div class="container-tight">
      <Reveal>
        <p class="text-sm font-semibold uppercase tracking-wider text-coral-700">{phil.eyebrow}</p>
        <h2 class="mt-3 text-3xl md:text-4xl leading-tight">{phil.heading}</h2>
      </Reveal>
      <div class="mt-8 grid md:grid-cols-3 gap-5">
        {phil.cards.map((card: any, i: number) => (
          <Reveal delay={i * 100}>
            <InfoCard heading={card.t}>{card.b}</InfoCard>
          </Reveal>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTACT CTA -->
  <ContactCTASection heading={cta.heading} body={cta.body} />

</Layout>
