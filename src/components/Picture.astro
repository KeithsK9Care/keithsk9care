---
export interface Props {
  src: string;        // filename stub, e.g. "cockapoo-after-groom"
  alt: string;
  width: number;
  height: number;
  size?: 800 | 1600; // pick a sized variant; omit for original
  priority?: boolean; // hero image — eager + fetchpriority=high
  class?: string;
}
const { src, alt, width, height, size, priority = false, class: cls = "w-full h-full object-cover" } = Astro.props;
const suffix = size ? `-${size}` : "";
const loading = priority ? "eager" : "lazy";
---
<picture>
  <source srcset={`/assets/photos/${src}${suffix}.webp`} type="image/webp" />
  <img
    src={`/assets/photos/${src}${suffix}.jpg`}
    alt={alt}
    width={width}
    height={height}
    class:list={[cls, "img-fade"]}
    loading={loading}
    decoding="async"
    onload="this.classList.add('img-loaded')"
    {...(priority ? { fetchpriority: "high" } : {})}
  />
</picture>

<style is:global>
  .img-fade { opacity: 0; transition: opacity 500ms ease-out; }
  .img-fade.img-loaded { opacity: 1; }
  /* Eager hero images shouldn't fade in — too noticeable */
  img[fetchpriority="high"].img-fade { opacity: 1; transition: none; }
  @media (prefers-reduced-motion: reduce) {
    .img-fade { opacity: 1; transition: none; }
  }
</style>
