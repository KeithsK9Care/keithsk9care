---
import fs from 'node:fs';
import path from 'node:path';

export interface Props {
  src: string;        // either a filename stub ("cockapoo-after-groom") OR a full path ("/assets/photos/MyDog.jpeg")
  alt: string;
  width: number;
  height: number;
  size?: 800 | 1600; // pick a sized variant; omit for original
  priority?: boolean; // hero image — eager + fetchpriority=high
  class?: string;
}
const { src, alt, width, height, size, priority = false, class: cls = "w-full h-full object-cover" } = Astro.props;
const loading = priority ? "eager" : "lazy";

// Build-time scan of the photo library — used to detect which images have pre-optimised
// -800.webp / -1200.jpg variants vs which are freshly uploaded originals (e.g. from Sveltia CMS).
// Computed once per build, not per render.
const PHOTOS_DIR = path.join(process.cwd(), 'public/assets/photos');
let availableFiles: Set<string>;
try {
  availableFiles = new Set(fs.readdirSync(PHOTOS_DIR));
} catch {
  availableFiles = new Set();
}

// Accept both formats:
//   - stub:      "cockapoo-after-groom"      → use pre-optimised variants
//   - full path: "/assets/photos/MyDog.jpeg" → strip prefix + extension, fall back if no variants
let stub = src;
let originalExt = 'jpg';
let originalPath: string | null = null;
if (src.startsWith('/')) {
  originalPath = src;
  const fname = src.replace(/^\/assets\/photos\//, '');
  const m = fname.match(/^(.+)\.([^.]+)$/);
  if (m) { stub = m[1]; originalExt = m[2].toLowerCase(); }
}

const suffix = size ? `-${size}` : "";
const avifName = `${stub}${suffix}.avif`;
const webpName = `${stub}${suffix}.webp`;
const jpgName  = `${stub}${suffix}.jpg`;
const hasAvifVariant = availableFiles.has(avifName);
const hasWebpVariant = availableFiles.has(webpName);
const hasJpgVariant  = availableFiles.has(jpgName);

// Fallback path for the <img> tag if no variants exist
const fallbackSrc = originalPath ?? `/assets/photos/${jpgName}`;
const imgSrc = hasJpgVariant ? `/assets/photos/${jpgName}` : fallbackSrc;
---
<picture>
  {hasAvifVariant && <source srcset={`/assets/photos/${avifName}`} type="image/avif" />}
  {hasWebpVariant && <source srcset={`/assets/photos/${webpName}`} type="image/webp" />}
  <img
    src={imgSrc}
    alt={alt}
    width={width}
    height={height}
    class:list={[cls, "img-fade"]}
    loading={loading}
    decoding="async"
    onload="this.classList.add('img-loaded')"
    {...(priority ? { fetchpriority: "high" } : {})}
  />
</picture>

<style is:global>
  .img-fade { opacity: 0; transition: opacity 500ms ease-out; }
  .img-fade.img-loaded { opacity: 1; }
  /* Gentle hover zoom — folds the load-fade + the scale into one transition so neither
     clobbers the other. Needs a .group ancestor (the card / photo tile). */
  .img-zoom { transition: opacity 500ms ease-out, transform 700ms ease-out; will-change: transform; }
  .group:hover .img-zoom { transform: scale(1.05); }
  /* Eager hero images shouldn't fade in — too noticeable */
  img[fetchpriority="high"].img-fade { opacity: 1; transition: none; }
  @media (prefers-reduced-motion: reduce) {
    .img-fade { opacity: 1; transition: none; }
    .group:hover .img-zoom { transform: none; }
  }
</style>
