---
import Layout from '../../layouts/Layout.astro';
import site from '../../data/site.json';
import { stories } from '../../lib/content';
import copy from '../../data/copy/groom-stories.json';
import PageHero from '../../components/PageHero.astro';
import StoryCard from '../../components/StoryCard.astro';
import Reveal from '../../components/Reveal.astro';
import ContactCTASection from '../../components/ContactCTASection.astro';
import Section from '../../components/Section.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { buildBreadcrumbSchema } from '../../lib/schemas';

const m = copy.meta;
const h = copy.hero;
const cta = copy.contactCta;

const sorted = [...stories].sort((a, b) => (b.date || '').localeCompare(a.date || ''));

const crumbs = [
  { name: "Home", url: `${site.url}/` },
  { name: "Groom Stories", url: `${site.url}/groom-stories/` },
];
const breadcrumbSchema = buildBreadcrumbSchema(crumbs);
---
<Layout title={m.title} description={m.description} ogImage={m.ogImage} schema={[breadcrumbSchema]}>

  <PageHero eyebrow={h.eyebrow} heading={h.heading} body={h.body} align="left" photo={h.photo} photoAlt={h.photoAlt}>
    <Breadcrumbs crumbs={crumbs} slot="before-eyebrow" />
    <a href={h.ctaPrimaryHref} class="btn-primary">{h.ctaPrimary}</a>
  </PageHero>

  <Section bg="white">
    <div class="container-wide">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {sorted.map((s, i) => (
          <Reveal delay={i * 70}>
            <StoryCard story={s} />
          </Reveal>
        ))}
      </div>
    </div>
  </Section>

  <ContactCTASection heading={cta.heading} body={cta.body} />
</Layout>
