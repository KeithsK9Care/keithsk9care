---
export interface Props {
  review: {
    author: string;
    location?: string;
    dog?: string;
    service?: string;
    rating: number;
    body: string;
    date?: string;
  };
  compact?: boolean;
}
const { review: r, compact = false } = Astro.props;
const stars = '★★★★★'.slice(0, r.rating) + '☆☆☆☆☆'.slice(0, 5 - r.rating);
---
<article class="rounded-2xl bg-white ring-1 ring-ink-100 p-6 h-full flex flex-col">
  <div class="flex items-center gap-1 text-coral-500 mb-2" aria-label={`${r.rating} out of 5`}>
    {[1,2,3,4,5].map(i => (
      <svg aria-hidden="true" class:list={['w-4 h-4', i <= r.rating ? 'fill-current' : 'fill-ink-200']} viewBox="0 0 20 20">
        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.957a1 1 0 00.95.69h4.162c.969 0 1.371 1.24.588 1.81l-3.37 2.448a1 1 0 00-.364 1.118l1.287 3.958c.3.922-.755 1.688-1.539 1.118l-3.37-2.448a1 1 0 00-1.175 0l-3.371 2.448c-.783.57-1.838-.197-1.539-1.118l1.287-3.958a1 1 0 00-.364-1.118L2.05 9.385c-.783-.57-.38-1.81.588-1.81h4.162a1 1 0 00.95-.69l1.286-3.957z"/>
      </svg>
    ))}
  </div>
  <blockquote class:list={['text-ink-800 leading-relaxed flex-1', compact ? 'text-sm' : '']}>
    "{r.body}"
  </blockquote>
  <footer class="mt-4 pt-4 border-t border-ink-100 text-sm">
    <p class="font-display font-semibold text-ink-900">{r.author}</p>
    <p class="text-xs text-ink-500 mt-0.5">
      {r.dog ? `${r.dog} · ` : ''}{r.location || ''}{r.service ? ` · ${r.service}` : ''}
    </p>
  </footer>
</article>
