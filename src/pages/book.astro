---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';

const title = "Book a groom | Keith's K9 Care";
const description = `Book Keith's K9 Care — call ${site.phone} or WhatsApp Keith. Home grooming salon in ${site.address.locality}, near Newmillerdam Country Park, ${site.address.postcode}.`;
---
<Layout title={title} description={description} noindex={true}>

  <section class="section">
    <div class="container-tight">
      <p class="text-sm font-semibold uppercase tracking-wider text-coral-500">Book a groom</p>
      <h1 class="mt-3 text-4xl md:text-5xl leading-tight">Get in touch with Keith.</h1>
      <p class="mt-5 text-lg text-ink-700 leading-relaxed max-w-2xl">
        Keith likes a quick chat about your dog before the first booking — coat type, age, any nerves — so he can pick the right slot. No bots, no answering service, just Keith.
      </p>

      <div class="mt-10 grid sm:grid-cols-3 gap-4">
        <a href={`tel:${site.phoneIntl}`} class="rounded-2xl bg-white ring-1 ring-ink-100 p-6 hover:ring-coral-300 hover:shadow-lg transition group">
          <p class="text-xs font-semibold uppercase tracking-wider text-coral-500">Call</p>
          <p class="mt-2 text-2xl font-display font-semibold text-teal-700 group-hover:text-coral-500">{site.phone}</p>
          <p class="mt-1 text-sm text-ink-600">Tap to dial — straight through to Keith.</p>
        </a>

        <a href={`https://wa.me/${site.whatsappIntl}?text=Hi%20Keith%2C%20I%27d%20like%20to%20book%20a%20groom%20for%20my%20dog.`} target="_blank" rel="noopener" class="rounded-2xl bg-whatsapp text-white p-6 hover:bg-green-600 transition">
          <p class="text-xs font-semibold uppercase tracking-wider text-white/80">WhatsApp</p>
          <p class="mt-2 text-2xl font-display font-semibold">Message Keith</p>
          <p class="mt-1 text-sm text-white/90">Tell him about your dog — he usually replies within an hour.</p>
        </a>

        <a href={`mailto:${site.email}`} class="rounded-2xl bg-white ring-1 ring-ink-100 p-6 hover:ring-coral-300 hover:shadow-lg transition group">
          <p class="text-xs font-semibold uppercase tracking-wider text-coral-500">Email</p>
          <p class="mt-2 text-lg font-display font-semibold text-teal-700 group-hover:text-coral-500 break-all">{site.email}</p>
          <p class="mt-1 text-sm text-ink-600">Drop Keith a line with your dog's details.</p>
        </a>
      </div>

      <!-- Address + hours card -->
      <div class="mt-12 grid md:grid-cols-2 gap-6">
        <div class="rounded-2xl bg-white ring-1 ring-ink-100 p-6">
          <p class="text-xs font-semibold uppercase tracking-wider text-coral-500 mb-3">Find us</p>
          <address class="not-italic text-ink-800 text-lg leading-relaxed">
            {site.address.street}<br/>
            {site.address.locality}, {site.address.region}<br/>
            {site.address.postcode}
          </address>
          <a href={`https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(site.address.street + ', ' + site.address.postcode)}`} target="_blank" rel="noopener" class="btn-ghost mt-4">
            Get directions
            <svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
          <p class="mt-4 text-sm text-ink-600">A short stroll from Newmillerdam Country Park.</p>
        </div>

        <div class="rounded-2xl bg-white ring-1 ring-ink-100 p-6">
          <p class="text-xs font-semibold uppercase tracking-wider text-coral-500 mb-3">Opening hours</p>
          <ul class="text-ink-800 space-y-1">
            {site.hours.map(h => (
              <li class="flex justify-between gap-4"><span class="font-semibold">{h.day}</span><span>{h.open}–{h.close}</span></li>
            ))}
          </ul>
          <p class="text-sm text-ink-600 mt-3">{site.hoursNote}</p>
        </div>
      </div>

      <p class="mt-10 text-sm text-ink-500">
        <a href="/" class="text-teal-700 font-semibold hover:text-coral-500">← Back to home</a>
      </p>
    </div>
  </section>

</Layout>
