---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';
import { reviews } from '../lib/content';
import copy from '../data/copy/reviews.json';
import PageHero from '../components/PageHero.astro';
import ReviewCard from '../components/ReviewCard.astro';
import Reveal from '../components/Reveal.astro';
import ContactCTACard from '../components/ContactCTACard.astro';
import { buildReviewSchema, buildAggregateRatingSchema, buildBreadcrumbSchema } from '../lib/schemas';

const m = copy.meta;
const h = copy.hero;
const cta = copy.contactCta;

const sorted = [...reviews].sort((a, b) => (b.date || '').localeCompare(a.date || ''));
const ratings = reviews.map(r => r.rating);
const hasReviews = reviews.length > 0;
const avg = hasReviews ? (ratings.reduce((a, b) => a + b, 0) / ratings.length).toFixed(1) : '0';

const heading = hasReviews
  ? h.headingWithReviewsTemplate
      .replace('{avg}', String(avg))
      .replace('{n}', String(reviews.length))
      .replace('{nounOwners}', reviews.length === 1 ? 'owner' : 'owners')
  : h.headingWithoutReviews;

const businessId = `${site.url}/#business`;
const reviewSchema = hasReviews ? buildReviewSchema({
  url: `${site.url}/reviews/`,
  businessId,
  businessName: site.name,
  reviews: sorted,
}) : null;
const aggregateSchema = hasReviews ? buildAggregateRatingSchema({ businessId, ratings }) : null;
const breadcrumbSchema = buildBreadcrumbSchema([
  { name: "Home", url: `${site.url}/` },
  { name: "Reviews", url: `${site.url}/reviews/` },
]);
---
<Layout title={m.title} description={m.description} ogImage={m.ogImage}>
  {reviewSchema    && <script slot="head" type="application/ld+json" set:html={JSON.stringify(reviewSchema)} />}
  {aggregateSchema && <script slot="head" type="application/ld+json" set:html={JSON.stringify(aggregateSchema)} />}
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <PageHero eyebrow={h.eyebrow} heading={heading} body={h.body}>
    <a href={h.ctaPrimaryHref} class="btn-primary">{h.ctaPrimary}</a>
    <a href={h.ctaSecondaryHref} class="btn-secondary">{h.ctaSecondary}</a>
  </PageHero>

  <section class="section">
    <div class="container-wide">
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {sorted.map((r, i) => (
          <Reveal delay={i * 60}>
            <ReviewCard review={r} />
          </Reveal>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-wide">
      <Reveal>
        <ContactCTACard heading={cta.heading} body={cta.body} />
      </Reveal>
    </div>
  </section>
</Layout>
