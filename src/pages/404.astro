---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found | Keith's K9 Care" description="That page doesn't exist." noindex={true}>
  <section class="section">
    <div class="container-tight text-center">
      <p class="text-sm font-semibold uppercase tracking-wider text-coral-500">404</p>
      <h1 class="mt-3 text-4xl md:text-5xl">We couldn't find that page.</h1>
      <p class="mt-5 text-ink-700">Lost? Sit. Stay. Try <a href="/" class="text-teal-700 font-semibold">the home page</a>.</p>
      <a href="/" class="btn-primary mt-8">Back to home</a>
    </div>
  </section>
</Layout>
