---
import fs from 'node:fs';
import path from 'node:path';

export interface Props {
  src: string;        // either a filename stub ("cockapoo-after-groom") OR a full path ("/assets/photos/MyDog.jpeg")
  alt: string;
  width: number;
  height: number;
  size?: 800 | 1600;  // deprecated/ignored — responsive srcset now emits every available width
  sizes?: string;     // CSS `sizes` attribute; override per call site (e.g. hero vs thumbnail)
  priority?: boolean; // hero image — eager + fetchpriority=high
  class?: string;
}
const {
  src, alt, width, height,
  sizes = "(max-width: 640px) 100vw, 800px",
  priority = false,
  class: cls = "w-full h-full object-cover",
} = Astro.props;
const loading = priority ? "eager" : "lazy";

// Build-time scan of the photo library — used to detect which optimised variants exist
// (pre-generated by scripts/generate-photo-variants.mjs). Computed once per build.
const PHOTOS_DIR = path.join(process.cwd(), 'public/assets/photos');
let availableFiles: Set<string>;
try {
  availableFiles = new Set(fs.readdirSync(PHOTOS_DIR));
} catch {
  availableFiles = new Set();
}

// Accept both a filename stub and a full /assets/photos/... path.
let stub = src;
let originalPath: string | null = null;
if (src.startsWith('/')) {
  originalPath = src;
  const fname = src.replace(/^\/assets\/photos\//, '');
  const m = fname.match(/^(.+)\.([^.]+)$/);
  if (m) { stub = m[1]; }
}

// Build a real responsive srcset from whichever ladder widths were generated for this image.
const WIDTHS = [400, 800, 1200, 1600];
const srcsetFor = (ext: string): string =>
  WIDTHS
    .filter((w) => availableFiles.has(`${stub}-${w}.${ext}`))
    .map((w) => `/assets/photos/${stub}-${w}.${ext} ${w}w`)
    .join(', ');
const avifSrcset = srcsetFor('avif');
const webpSrcset = srcsetFor('webp');
const jpgSrcset  = srcsetFor('jpg');

// Full-size companions, used when no sized ladder exists (e.g. a very small image).
const hasFullAvif = availableFiles.has(`${stub}.avif`);
const hasFullWebp = availableFiles.has(`${stub}.webp`);

// <img> fallback src: prefer the 800 JPEG, then the full JPEG, then the original path.
const imgSrc = availableFiles.has(`${stub}-800.jpg`)
  ? `/assets/photos/${stub}-800.jpg`
  : (availableFiles.has(`${stub}.jpg`) ? `/assets/photos/${stub}.jpg` : (originalPath ?? `/assets/photos/${stub}.jpg`));
---
<picture>
  {avifSrcset
    ? <source srcset={avifSrcset} sizes={sizes} type="image/avif" />
    : hasFullAvif && <source srcset={`/assets/photos/${stub}.avif`} type="image/avif" />}
  {webpSrcset
    ? <source srcset={webpSrcset} sizes={sizes} type="image/webp" />
    : hasFullWebp && <source srcset={`/assets/photos/${stub}.webp`} type="image/webp" />}
  <img
    src={imgSrc}
    srcset={jpgSrcset || undefined}
    sizes={jpgSrcset ? sizes : undefined}
    alt={alt}
    width={width}
    height={height}
    class:list={[cls, "img-fade"]}
    loading={loading}
    decoding="async"
    onload="this.classList.add('img-loaded')"
    {...(priority ? { fetchpriority: "high" } : {})}
  />
</picture>

<style is:global>
  .img-fade { opacity: 0; transition: opacity 500ms ease-out; }
  .img-fade.img-loaded { opacity: 1; }
  /* Gentle hover zoom — folds the load-fade + the scale into one transition so neither
     clobbers the other. Needs a .group ancestor (the card / photo tile). */
  .img-zoom { transition: opacity 500ms ease-out, transform 700ms ease-out; will-change: transform; }
  .group:hover .img-zoom { transform: scale(1.05); }
  /* Eager hero images shouldn't fade in — too noticeable */
  img[fetchpriority="high"].img-fade { opacity: 1; transition: none; }
  @media (prefers-reduced-motion: reduce) {
    .img-fade { opacity: 1; transition: none; }
    .group:hover .img-zoom { transform: none; }
  }
</style>
