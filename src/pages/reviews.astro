---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';
import reviews from '../data/reviews.json';
import PageHero from '../components/PageHero.astro';
import ReviewCard from '../components/ReviewCard.astro';
import Reveal from '../components/Reveal.astro';
import ContactCTACard from '../components/ContactCTACard.astro';
import { buildReviewSchema, buildAggregateRatingSchema, buildBreadcrumbSchema } from '../lib/schemas';

const sorted = [...reviews].sort((a, b) => (b.date || '').localeCompare(a.date || ''));
const ratings = reviews.map(r => r.rating);
const avg = (ratings.reduce((a, b) => a + b, 0) / ratings.length).toFixed(1);

const title = "Reviews | Keith's K9 Care";
const description = `${reviews.length} reviews from dog owners across Hall Green, Newmillerdam, Crigglestone, Sandal and the wider Wakefield area. ${avg} out of 5 average.`;

const businessId = `${site.url}/#business`;
const reviewSchema = buildReviewSchema({
  url: `${site.url}/reviews/`,
  businessId,
  businessName: site.name,
  reviews: sorted,
});
const aggregateSchema = buildAggregateRatingSchema({ businessId, ratings });
const breadcrumbSchema = buildBreadcrumbSchema([
  { name: "Home", url: `${site.url}/` },
  { name: "Reviews", url: `${site.url}/reviews/` },
]);
---
<Layout title={title} description={description} ogImage="/assets/photos/keith-with-cocker-spaniel.jpg">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(reviewSchema)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(aggregateSchema)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <PageHero
    eyebrow="Reviews"
    heading={`${avg} out of 5 — from ${reviews.length} dog owners.`}
    body="What Keith's customers say after their dog's visit — coat type, service, the lot. Honest, unfiltered, locally collected."
  >
    <a href="/book/" class="btn-primary">Book your dog in</a>
    <a href="/services/" class="btn-secondary">See services</a>
  </PageHero>

  <section class="section">
    <div class="container-wide">
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {sorted.map((r, i) => (
          <Reveal delay={i * 60}>
            <ReviewCard review={r} />
          </Reveal>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-wide">
      <Reveal>
        <ContactCTACard heading="Want to leave a review?" body="If Keith's groomed your dog, drop him a message — he'll send you the Google review link and (with permission) feature your words here too." />
      </Reveal>
    </div>
  </section>
</Layout>
