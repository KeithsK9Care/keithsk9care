---
import Picture from './Picture.astro';
import Reveal from './Reveal.astro';
export interface Props {
  photos: { src: string; alt: string }[];
  cols?: 2 | 3;        // mobile is always 2; this is md+
  size?: 800 | 1600;
}
const { photos, cols = 3, size = 800 } = Astro.props;
const colsCls = cols === 3 ? 'md:grid-cols-3' : 'md:grid-cols-2';
---
<div class:list={['grid grid-cols-2 gap-3 md:gap-5', colsCls]}>
  {photos.map((p, i) => (
    <Reveal delay={i * 70}>
      <div class="relative rounded-2xl overflow-hidden aspect-square ring-1 ring-ink-100">
        <Picture src={p.src} size={size} alt={p.alt} width={800} height={800} />
      </div>
    </Reveal>
  ))}
</div>
