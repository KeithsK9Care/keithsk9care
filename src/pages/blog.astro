---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';
const title = "Blog | Keith's K9 Care";
const description = "Articles and guides from Keith's K9 Care.";
---
<Layout title={title} description={description} noindex={true}>
  <section class="section">
    <div class="container-tight text-center">
      <p class="text-sm font-semibold uppercase tracking-wider text-coral-500">Blog</p>
      <h1 class="mt-3 text-4xl md:text-5xl">Coming soon</h1>
      <p class="mt-5 text-ink-700">This page is being built. In the meantime, give Keith a call on <a href={`tel:${site.phoneIntl}`} class="text-teal-700 font-semibold">{site.phone}</a>.</p>
      <a href="/" class="btn-secondary mt-8">Back to home</a>
    </div>
  </section>
</Layout>
