---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';
import { areas } from '../lib/content';
import copy from '../data/copy/areas.json';
import PageHero from '../components/PageHero.astro';
import Reveal from '../components/Reveal.astro';
import AreaPill from '../components/AreaPill.astro';
import ReviewStrip from '../components/ReviewStrip.astro';
import ContactCTASection from '../components/ContactCTASection.astro';
import Section from '../components/Section.astro';
import { buildBreadcrumbSchema } from '../lib/schemas';

const m = copy.meta;
const h = copy.hero;
const overview: string[] = copy.overview ?? [];

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: "Home", url: `${site.url}/` },
  { name: "Areas we cover", url: `${site.url}/areas/` },
]);
---
<Layout title={m.title} description={m.description} ogImage={m.ogImage} schema={[breadcrumbSchema]}>
  <PageHero
    eyebrow={h.eyebrow}
    heading={h.heading}
    body={h.body}
    align="left"
    photo={h.photo}
    photoAlt={h.photoAlt}
  >
    <a href={h.ctaPrimaryHref} class="btn-primary">{h.ctaPrimary}</a>
    <a href={h.ctaSecondaryHref} class="btn-secondary">{h.ctaSecondary}</a>
  </PageHero>

  <ReviewStrip />

  <Section bg="white">
    <div class="container-wide">
      <Reveal class="flex flex-wrap gap-2">
        {areas.map(a => <AreaPill area={a} />)}
      </Reveal>

      <Reveal delay={200} class="mt-10 text-center">
        <a href="/book/" class="btn-primary">{copy.ctaText}</a>
      </Reveal>
    </div>
  </Section>

  <!-- COVERAGE OVERVIEW -->
  {overview.length > 0 && (
    <Section bg="teal">
      <div class="container-tight">
        <div class="space-y-5 text-lg text-ink-700 leading-relaxed">
          {overview.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </Section>
  )}

  <ContactCTASection heading={copy.contactCta.heading} body={copy.contactCta.body} />
</Layout>
