---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';
import copy from '../data/copy/404.json';
import Reveal from '../components/Reveal.astro';

const m = copy.meta;
const h = copy.hero;
const links = copy.links;
---
<Layout title={m.title} description={m.description} noindex={true} hideWhatsApp={true} ogImage={m.ogImage}>
  <section class="section">
    <div class="container-tight text-center">
      <Reveal>
        <p class="text-sm font-semibold uppercase tracking-wider text-coral-700">{h.eyebrow}</p>
        <h1 class="mt-3 text-4xl md:text-5xl">{h.heading}</h1>
        <p class="mt-5 text-ink-700">{h.body}</p>
        <div class="mt-8 grid sm:grid-cols-2 gap-3 max-w-md mx-auto">
          {links.map((l: any) => (
            <a href={l.href} class:list={[l.variant === 'primary' ? 'btn-primary' : 'btn-secondary', 'justify-center']}>{l.label}</a>
          ))}
        </div>
        <p class="mt-8 text-sm text-ink-600">
          {h.callPrompt} <a href={`tel:${site.phoneIntl}`} class="text-teal-700 font-semibold hover:text-coral-700">{site.phone}</a>.
        </p>
      </Reveal>
    </div>
  </section>
</Layout>
