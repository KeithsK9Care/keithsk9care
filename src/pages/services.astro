---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';
import { services } from '../lib/content';
import copy from '../data/copy/services.json';
import SectionIntro from '../components/SectionIntro.astro';
import Reveal from '../components/Reveal.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Section from '../components/Section.astro';
import PageHero from '../components/PageHero.astro';
import ContactCTASection from '../components/ContactCTASection.astro';
import { buildBreadcrumbSchema } from '../lib/schemas';
import ReviewStrip from '../components/ReviewStrip.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const m = copy.meta;
const h = copy.hero;
const trans = copy.transparency;
const cta = copy.contactCta;
const overview: string[] = copy.overview ?? [];

const crumbs = [
  { name: "Home", url: `${site.url}/` },
  { name: "Services", url: `${site.url}/services/` },
];
const breadcrumbSchema = buildBreadcrumbSchema(crumbs);
---
<Layout title={m.title} description={m.description} ogImage={m.ogImage} schema={[breadcrumbSchema]}>

  <PageHero eyebrow={h.eyebrow} heading={h.heading} body={h.body} align="left" photo={h.photo} photoAlt={h.photoAlt}>
    <Breadcrumbs crumbs={crumbs} slot="before-eyebrow" />
    <a href={h.ctaPrimaryHref} class="btn-primary">{h.ctaPrimary}</a>
    <a href={h.ctaSecondaryHref} class="btn-secondary">{h.ctaSecondary}</a>
  </PageHero>

  <ReviewStrip />

  <!-- SERVICES GRID -->
  <Section bg="white">
    <div class="container-wide">
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((s, i) => (
          <Reveal delay={i * 60}>
            <ServiceCard service={s} index={i} />
          </Reveal>
        ))}
      </div>
    </div>
  </Section>

  <!-- OVERVIEW -->
  {overview.length > 0 && (
    <Section bg="white" class="pt-0">
      <div class="container-tight space-y-5 text-lg text-ink-700 leading-relaxed">
        {overview.map((p) => <p>{p}</p>)}
      </div>
    </Section>
  )}

  <!-- TRANSPARENCY CALLOUT -->
  <Section bg="teal">
    <div class="container-tight text-center">
      <Reveal>
        <SectionIntro
          eyebrow={trans.eyebrow}
          heading={trans.heading}
          description={trans.description}
          align="center"
        />
        <a href={trans.ctaHref} class="btn-primary mt-7">{trans.ctaText}</a>
      </Reveal>
    </div>
  </Section>

  <!-- CONTACT CTA -->
  <ContactCTASection heading={cta.heading} body={cta.body} />
</Layout>
